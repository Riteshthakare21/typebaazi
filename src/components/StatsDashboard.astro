<script>
  import { StorageManager } from '../lib/storage';
  import { AuthManager } from '../lib/auth';
  import { getLevelInfo, BADGES } from '../lib/gamification';

  function initDashboard() {
    const stats = StorageManager.getStats();
    const levelInfo = getLevelInfo(stats.xp);

    const settings = StorageManager.getSettings();
    const userName = settings.userName || 'Speed Champion';
    const userAvatar = settings.userAvatar || '🏎️';

    // Account Sync Banner update
    const profile = AuthManager.getUserProfile();
    const accIcon = document.getElementById('dash-acc-icon');
    const accTitle = document.getElementById('dash-acc-status-title');
    const accPill = document.getElementById('dash-acc-status-pill');
    const accDesc = document.getElementById('dash-acc-status-desc');
    const accBtn = document.getElementById('dash-acc-cta-btn');

    if (profile.isRegistered) {
      if (accIcon) accIcon.textContent = '👑';
      if (accTitle) accTitle.textContent = `Cloud Synced: ${profile.username}`;
      if (accPill) {
        accPill.textContent = '✓ Cloud Synced';
        accPill.classList.add('is-active');
      }
      if (accDesc) accDesc.textContent = 'Your daily streak, personal bests, and test records are securely synced to your TypeBaazi cloud profile.';
      if (accBtn) {
        accBtn.innerHTML = '<span>⚙️ Account Settings</span>';
        accBtn.className = 'btn-secondary acc-sync-cta-btn';
      }
    } else {
      if (accIcon) accIcon.textContent = '☁️';
      if (accTitle) accTitle.textContent = 'Playing as Guest';
      if (accPill) {
        accPill.textContent = 'Local Storage';
        accPill.classList.remove('is-active');
      }
      if (accDesc) accDesc.textContent = 'Your progress is saved locally on this browser. Sign in to save your streak, scores and progress across devices.';
      if (accBtn) {
        accBtn.innerHTML = '<span>✨ Sign Up / Save Progress</span>';
        accBtn.className = 'btn-primary acc-sync-cta-btn';
      }
    }

    if (accBtn) {
      accBtn.onclick = () => {
        if (typeof (window as any).openTypeBaaziAuthModal === 'function') {
          (window as any).openTypeBaaziAuthModal();
        }
      };
    }

    // Level & XP
    const lvlNum = document.getElementById('dash-lvl-num');
    const avatarEl = document.getElementById('dash-user-avatar');
    const nameEl = document.getElementById('dash-user-name');
    const badgeEl = document.getElementById('dash-rank-badge');
    const xpBar = document.getElementById('dash-xp-bar');
    const currentXp = document.getElementById('dash-current-xp');
    const neededXp = document.getElementById('dash-needed-xp');

    if (lvlNum) lvlNum.textContent = String(levelInfo.level);
    if (avatarEl) avatarEl.textContent = userAvatar;
    if (nameEl) nameEl.textContent = userName;
    if (badgeEl) badgeEl.textContent = `• ${levelInfo.title}`;
    if (xpBar) xpBar.style.width = `${levelInfo.progressPercent}%`;
    if (currentXp) currentXp.textContent = `${stats.xp} Total XP`;
    if (neededXp) neededXp.textContent = `Next Level at ${levelInfo.maxXp} XP`;

    // Streaks
    const curStreak = document.getElementById('dash-current-streak');
    const longStreak = document.getElementById('dash-longest-streak');
    if (curStreak) curStreak.textContent = String(stats.currentStreak || 0);
    if (longStreak) longStreak.textContent = String(stats.longestStreak || 0);

    // English records
    const enWpm = document.getElementById('dash-en-best-wpm');
    const enAcc = document.getElementById('dash-en-best-acc');
    const enTests = document.getElementById('dash-en-tests');
    if (enWpm) enWpm.textContent = String(stats.english.bestWpm);
    if (enAcc) enAcc.textContent = `${stats.english.bestAccuracy}%`;
    if (enTests) enTests.textContent = String(stats.english.totalTests || (stats.english as any).testsCompleted || 0);

    // Hindi records
    const hiWpm = document.getElementById('dash-hi-best-wpm');
    const hiAcc = document.getElementById('dash-hi-best-acc');
    const hiTests = document.getElementById('dash-hi-tests');
    if (hiWpm) hiWpm.textContent = String(stats.hindi?.bestWpm || 0);
    if (hiAcc) hiAcc.textContent = `${stats.hindi?.bestAccuracy || 0}%`;
    if (hiTests) hiTests.textContent = String(stats.hindi?.totalTests || 0);

    // Marathi records
    const mrWpm = document.getElementById('dash-mr-best-wpm');
    const mrAcc = document.getElementById('dash-mr-best-acc');
    const mrTests = document.getElementById('dash-mr-tests');
    if (mrWpm) mrWpm.textContent = String(stats.marathi.bestWpm);
    if (mrAcc) mrAcc.textContent = `${stats.marathi.bestAccuracy}%`;
    if (mrTests) mrTests.textContent = String(stats.marathi.totalTests || (stats.marathi as any).testsCompleted || 0);

    // Streak Road Milestones
    const streakBadge = document.getElementById('dash-streak-status-badge');
    const effectiveStreak = Math.max(stats.currentStreak || 0, stats.longestStreak || 0);
    if (streakBadge) streakBadge.textContent = `Current: ${stats.currentStreak || 0} Days • Longest: ${stats.longestStreak || 0} Days`;

    const streakTiers = [
      { days: 7, cardId: 'ms-card-7', statusId: 'ms-status-7', btnId: null, type: null },
      { days: 25, cardId: 'ms-card-25', statusId: 'ms-status-25', btnId: 'ms-btn-25', type: 'streak-25' },
      { days: 50, cardId: 'ms-card-50', statusId: 'ms-status-50', btnId: 'ms-btn-50', type: 'streak-50' },
      { days: 100, cardId: 'ms-card-100', statusId: 'ms-status-100', btnId: 'ms-btn-100', type: 'streak-100' },
      { days: 365, cardId: 'ms-card-365', statusId: 'ms-status-365', btnId: 'ms-btn-365', type: 'streak-365' }
    ];

    streakTiers.forEach(tier => {
      const card = document.getElementById(tier.cardId);
      const status = document.getElementById(tier.statusId);
      const btn = tier.btnId ? document.getElementById(tier.btnId) : null;

      if (effectiveStreak >= tier.days) {
        if (card) card.classList.add('unlocked-ms');
        if (status) status.textContent = '✓ Milestone Unlocked!';
        if (btn) btn.classList.remove('hidden');
      } else {
        if (card) card.classList.remove('unlocked-ms');
        if (status) status.textContent = `In Progress (${effectiveStreak}/${tier.days}d)`;
        if (btn) btn.classList.add('hidden');
      }

      btn?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-certificate-modal', {
          detail: {
            type: tier.type as any,
            streakDays: tier.days,
            wpm: Math.max(stats.english.bestWpm, stats.marathi.bestWpm) || 65
          }
        }));
      });
    });

    // Profile & Streak Hub trigger on Dashboard
    document.getElementById('btn-dash-open-profile')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-profile-modal'));
    });

    // Badges Room
    const badgesContainer = document.getElementById('dash-badges-container');
    const badgeCountLabel = document.getElementById('dash-badge-count');
    const unlockedSet = new Set(stats.unlockedBadgeIds || []);

    if (badgeCountLabel) {
      badgeCountLabel.textContent = `${unlockedSet.size} of ${BADGES.length} Badges Unlocked`;
    }

    if (badgesContainer) {
      badgesContainer.innerHTML = BADGES.map(b => {
        const isUnlocked = unlockedSet.has(b.id);
        const isGold = b.id === 'badge-speed-100' || b.id === 'badge-streak-50' || b.id === 'badge-streak-100' || b.id === 'badge-streak-365' || b.id === 'badge-bot-slayer' || b.id === 'badge-perfectionist';
        const hasCert = b.id === 'badge-bot-slayer' || b.id === 'badge-streak-50' || b.id === 'badge-streak-100' || b.id === 'badge-streak-365' || b.id === 'badge-speed-100';

        return `
          <div class="badge-card-item ${isUnlocked ? 'unlocked' : 'locked'} ${isGold ? 'gold-tier' : ''}">
            <div class="badge-card-top">
              <div class="badge-icon-box">
                <span class="badge-card-icon">${b.icon}</span>
                ${isUnlocked ? '<span class="badge-sparkle">✨</span>' : ''}
              </div>
              <div class="badge-title-group">
                <div class="badge-card-name">${b.name}</div>
                <div class="badge-card-mr">${b.nameMr}</div>
              </div>
            </div>
            <div class="badge-card-middle">
              <span class="badge-status-tag ${isUnlocked ? (isGold ? 'tag-gold' : 'tag-unlocked') : 'tag-locked'}">
                ${isUnlocked ? (isGold ? '👑 LEGENDARY UNLOCKED' : '✓ UNLOCKED') : '🔒 LOCKED'}
              </span>
            </div>
            <p class="badge-card-desc">${b.description}</p>
            ${isUnlocked && hasCert ? `
              <button class="btn-badge-cert no-print" data-badge-id="${b.id}" style="margin-top: auto; padding: 4px 10px; font-size: 11px; font-weight: 800; color: #fbbf24; background: rgba(251, 191, 36, 0.12); border: 1px solid rgba(251, 191, 36, 0.4); border-radius: 6px; cursor: pointer; transition: all 0.2s ease;">
                📜 View Certificate
              </button>
            ` : ''}
          </div>
        `;
      }).join('');

      // Certificate triggers on Badges Room
      badgesContainer.querySelectorAll('.btn-badge-cert').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const badgeId = (e.currentTarget as HTMLElement).dataset.badgeId;
          let certType: any = 'speed-60';
          if (badgeId === 'badge-speed-100') certType = 'speed-100';
          else if (badgeId === 'badge-streak-50') certType = 'streak-50';
          else if (badgeId === 'badge-streak-100') certType = 'streak-100';
          else if (badgeId === 'badge-streak-365') certType = 'streak-365';
          else if (badgeId === 'badge-bot-slayer') certType = 'bot-master';

          window.dispatchEvent(new CustomEvent('open-certificate-modal', {
            detail: {
              type: certType,
              streakDays: stats.longestStreak || 50,
              wpm: Math.max(stats.english.bestWpm, stats.hindi.bestWpm, stats.marathi.bestWpm) || 85,
              accuracy: Math.max(stats.english.bestAccuracy, stats.hindi.bestAccuracy, stats.marathi.bestAccuracy) || 98
            }
          }));
        });
      });
    }

    // Render SVG Speed Progression Curve
    renderSpeedChart(stats.history || []);

    // Recent History Table
    const tbody = document.getElementById('dash-history-tbody');
    if (tbody) {
      if (!stats.history || stats.history.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: var(--text-muted); padding: 24px;">No test runs recorded yet. Start a test to see your history!</td></tr>`;
      } else {
        tbody.innerHTML = stats.history.slice(0, 10).map(h => {
          const dateStr = new Date(h.timestamp).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
          const langFlag = h.language === 'marathi' ? '🇮🇳 मराठी' : '🇬🇧 ';
          return `
            <tr>
              <td>${dateStr}</td>
              <td>${langFlag}</td>
              <td><span class="badge badge-cyan">${h.mode}</span></td>
              <td><strong style="color: var(--accent-cyan); font-family: var(--font-mono);">${h.wpm} WPM</strong></td>
              <td>${h.accuracy}%</td>
              <td>${h.errors}</td>
            </tr>
          `;
        }).join('');
      }
    }
  }

  function renderSpeedChart(history: { wpm: number; timestamp: number }[]) {
    const svg = document.getElementById('wpm-svg-chart');
    if (!svg) return;

    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    const gridStroke = isLight ? 'rgba(0,0,0,0.08)' : 'rgba(255,255,255,0.08)';
    const textFill = isLight ? '#0f172a' : '#ffffff';
    const circleStroke = isLight ? '#ffffff' : '#080c14';
    const lineColor = isLight ? '#0070f3' : '#00f0ff';

    const data = history.slice(0, 20).reverse().map(h => h.wpm);
    if (data.length === 0) {
      svg.innerHTML = `<text x="350" y="100" text-anchor="middle" fill="${isLight ? '#64748b' : '#94a3b8'}" font-size="14">No data yet. Complete tests to render your speed curve.</text>`;
      return;
    }

    const width = 700;
    const height = 200;
    const padding = 30;
    const maxWpm = Math.max(80, Math.max(...data) + 15);
    const minWpm = 0;

    const stepX = (width - padding * 2) / Math.max(1, data.length - 1);

    let pathD = '';
    const points: { x: number; y: number; val: number }[] = [];

    data.forEach((val, i) => {
      const x = padding + i * stepX;
      const y = height - padding - ((val - minWpm) / (maxWpm - minWpm)) * (height - padding * 2);
      points.push({ x, y, val });
      if (i === 0) pathD += `M ${x} ${y}`;
      else pathD += ` L ${x} ${y}`;
    });

    let html = `
      <!-- Grid lines -->
      <line x1="${padding}" y1="${height - padding}" x2="${width - padding}" y2="${height - padding}" stroke="${gridStroke}" />
      <line x1="${padding}" y1="${height / 2}" x2="${width - padding}" y2="${height / 2}" stroke="${gridStroke}" stroke-dasharray="4" />
      <line x1="${padding}" y1="${padding}" x2="${width - padding}" y2="${padding}" stroke="${gridStroke}" stroke-dasharray="4" />

      <!-- Speed Line -->
      <path d="${pathD}" fill="none" stroke="${lineColor}" stroke-width="3" stroke-linecap="round" />
    `;

    // Add dots
    points.forEach(p => {
      html += `
        <circle cx="${p.x}" cy="${p.y}" r="5" fill="${lineColor}" stroke="${circleStroke}" stroke-width="2" />
        <text x="${p.x}" y="${p.y - 10}" text-anchor="middle" fill="${textFill}" font-size="11" font-weight="bold" font-family="monospace">${p.val}</text>
      `;
    });

    svg.innerHTML = html;
  }

  // Delegated click handler for Profile & Streak Hub and Certificates
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#btn-dash-open-profile, .btn-profile-hub')) {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('open-profile-modal'));
      const modal = document.getElementById('typebaazi-profile-modal');
      if (modal) modal.classList.remove('hidden');
    }
  });

  document.addEventListener('astro:page-load', initDashboard);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDashboard);
  } else {
    initDashboard();
  }

  window.addEventListener('user-name-changed', initDashboard);
  window.addEventListener('user-avatar-changed', initDashboard);
  window.addEventListener('profile-saved', initDashboard);
  window.addEventListener('stats-updated', initDashboard);
</script>
