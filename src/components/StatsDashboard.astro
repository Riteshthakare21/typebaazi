---
---

<div class="dashboard-wrapper">
  <!-- Cloud Sync & Account Status Banner -->
  <div class="account-sync-banner glass-panel" id="dash-account-banner">
    <div class="acc-sync-left">
      <div class="acc-sync-icon-wrapper">
        <span class="acc-sync-icon" id="dash-acc-icon">☁️</span>
      </div>
      <div class="acc-sync-info">
        <div class="acc-sync-title-row">
          <strong id="dash-acc-status-title">Playing as Guest</strong>
          <span class="acc-status-pill" id="dash-acc-status-pill">Local Storage</span>
        </div>
        <p id="dash-acc-status-desc">Your progress is saved locally on this browser. Sign in to sync your streak, speed records, and badges across devices.</p>
      </div>
    </div>
    <div class="acc-sync-right">
      <button type="button" class="btn-primary acc-sync-cta-btn" id="dash-acc-cta-btn">
        <span>✨ Sign Up / Save Progress</span>
      </button>
    </div>
  </div>

  <!-- Level & XP Hero Banner -->
  <div class="level-banner glass-panel">
    <div class="level-left">
      <div class="level-badge-large">
        <span class="level-num" id="dash-lvl-num">1</span>
        <span class="level-lbl">LEVEL</span>
      </div>
      <div class="level-meta">
        <div class="level-title-row">
          <h2 class="level-title" id="dash-rank-title">
            <span class="dash-user-avatar" id="dash-user-avatar">🏎️</span>
            <span class="dash-user-name" id="dash-user-name">Speed Champion</span>
            <span class="dash-rank-badge" id="dash-rank-badge">• Keyboard Rookie</span>
          </h2>
        </div>
        <div class="xp-bar-container">
          <div class="xp-bar-track">
            <div class="xp-bar-glow" id="dash-xp-bar" style="width: 25%;"></div>
          </div>
          <div class="xp-text-row">
            <span id="dash-current-xp">120 XP</span>
            <span id="dash-needed-xp">Next Level in 80 XP</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Streaks Pill -->
    <!-- Quick Streaks Pill & Profile Trigger -->
    <div class="streak-box">
      <div class="streak-stat">
        <span class="streak-icon">🔥</span>
        <div class="streak-info">
          <span class="streak-val" id="dash-current-streak">0</span>
          <span class="streak-lbl">Current Streak</span>
        </div>
      </div>
      <div class="streak-stat">
        <span class="streak-icon">⚡</span>
        <div class="streak-info">
          <span class="streak-val" id="dash-longest-streak">0</span>
          <span class="streak-lbl">Longest Streak</span>
        </div>
      </div>
      <button id="btn-dash-open-profile" class="btn-profile-hub" title="Open Racer Profile & Daily Streak Hub">
        <span>👤 Profile &amp; Streak Hub</span>
      </button>
    </div>
  </div>

  <!-- Language Bests Grid -->
  <div class="bests-grid">
    <!-- English Record Card -->
    <div class="best-card glass-panel border-cyan">
      <div class="best-card-header">
        <span class="lang-flag">🇬🇧</span>
        <h3>English Records</h3>
      </div>
      <div class="best-stats-row">
        <div class="best-stat">
          <span class="val-big" id="dash-en-best-wpm">0</span>
          <span class="lbl-small">Best WPM</span>
        </div>
        <div class="best-stat">
          <span class="val-big" id="dash-en-best-acc">0%</span>
          <span class="lbl-small">Best Accuracy</span>
        </div>
        <div class="best-stat">
          <span class="val-big" id="dash-en-tests">0</span>
          <span class="lbl-small">Total Tests</span>
        </div>
      </div>
    </div>

    <!-- Hindi Record Card -->
    <div class="best-card glass-panel border-gold">
      <div class="best-card-header">
        <span class="lang-flag">🇮🇳</span>
        <h3>हिंदी Records (Devanagari)</h3>
      </div>
      <div class="best-stats-row">
        <div class="best-stat">
          <span class="val-big" id="dash-hi-best-wpm">0</span>
          <span class="lbl-small">Best WPM</span>
        </div>
        <div class="best-stat">
          <span class="val-big" id="dash-hi-best-acc">0%</span>
          <span class="lbl-small">Best Accuracy</span>
        </div>
        <div class="best-stat">
          <span class="val-big" id="dash-hi-tests">0</span>
          <span class="lbl-small">Total Tests</span>
        </div>
      </div>
    </div>

    <!-- Marathi Record Card -->
    <div class="best-card glass-panel border-pink">
      <div class="best-card-header">
        <span class="lang-flag">🇮🇳</span>
        <h3>मराठी Records (Devanagari)</h3>
      </div>
      <div class="best-stats-row">
        <div class="best-stat">
          <span class="val-big" id="dash-mr-best-wpm">0</span>
          <span class="lbl-small">Best WPM</span>
        </div>
        <div class="best-stat">
          <span class="val-big" id="dash-mr-best-acc">0%</span>
          <span class="lbl-small">Best Accuracy</span>
        </div>
        <div class="best-stat">
          <span class="val-big" id="dash-mr-tests">0</span>
          <span class="lbl-small">Total Tests</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive SVG Speed Progression Chart -->
  <div class="chart-panel glass-panel">
    <div class="chart-header">
      <div class="chart-title">
        <span>📈 WPM Speed History (Recent Tests)</span>
      </div>
      <span class="chart-subtitle">Progress over your latest 20 typing runs</span>
    </div>
    <div class="chart-svg-wrapper" id="wpm-chart-container">
      <svg id="wpm-svg-chart" viewBox="0 0 700 200" class="wpm-svg">
        <!-- Grid lines & curve populated via JS -->
      </svg>
    </div>
  </div>

  <!-- Streak Milestone Rewards & Certificates Road -->
  <div class="streak-road-panel glass-panel">
    <div class="streak-road-header">
      <div class="streak-road-title">
        <span>🔥 Streak Milestone Rewards & Official Certificates</span>
      </div>
      <span class="streak-road-badge" id="dash-streak-status-badge">Current: 0 Days</span>
    </div>

    <div class="milestones-track" id="dash-milestones-track">
      <!-- 7 Days -->
      <div class="milestone-card" id="ms-card-7">
        <div class="ms-top">
          <span class="ms-icon">🗓️</span>
          <span class="ms-days">7 Days</span>
        </div>
        <h4 class="ms-title">Week Starter</h4>
        <p class="ms-reward">+100 Bonus XP & Trophy Badge</p>
        <div class="ms-status" id="ms-status-7">In Progress</div>
      </div>

      <!-- 25 Days -->
      <div class="milestone-card" id="ms-card-25">
        <div class="ms-top">
          <span class="ms-icon">🥈</span>
          <span class="ms-days">25 Days</span>
        </div>
        <h4 class="ms-title">Silver Streak</h4>
        <p class="ms-reward">+300 Bonus XP & Silver Medal</p>
        <button class="ms-cert-btn hidden" id="ms-btn-25" data-cert-type="streak-25">🎓 Claim Certificate</button>
        <div class="ms-status" id="ms-status-25">Locked (25d)</div>
      </div>

      <!-- 50 Days -->
      <div class="milestone-card gold-ms" id="ms-card-50">
        <div class="ms-top">
          <span class="ms-icon">🥇</span>
          <span class="ms-days">50 Days</span>
        </div>
        <h4 class="ms-title">Golden Mastery</h4>
        <p class="ms-reward">+750 XP & Official Certificate</p>
        <button class="ms-cert-btn hidden" id="ms-btn-50" data-cert-type="streak-50">🎓 Claim Certificate</button>
        <div class="ms-status" id="ms-status-50">Locked (50d)</div>
      </div>

      <!-- 100 Days -->
      <div class="milestone-card diamond-ms" id="ms-card-100">
        <div class="ms-top">
          <span class="ms-icon">💎</span>
          <span class="ms-days">100 Days</span>
        </div>
        <h4 class="ms-title">Century Legend</h4>
        <p class="ms-reward">+1500 XP & Grandmaster Award</p>
        <button class="ms-cert-btn hidden" id="ms-btn-100" data-cert-type="streak-100">🎓 Claim Certificate</button>
        <div class="ms-status" id="ms-status-100">Locked (100d)</div>
      </div>

      <!-- 365 Days -->
      <div class="milestone-card legend-ms" id="ms-card-365">
        <div class="ms-top">
          <span class="ms-icon">⭐</span>
          <span class="ms-days">365 Days</span>
        </div>
        <h4 class="ms-title">Hall of Fame</h4>
        <p class="ms-reward">+5000 XP & Lifetime Master Certificate</p>
        <button class="ms-cert-btn hidden" id="ms-btn-365" data-cert-type="streak-365">🎓 Claim Certificate</button>
        <div class="ms-status" id="ms-status-365">Locked (365d)</div>
      </div>
    </div>
  </div>

  <!-- Achievements / Badges Trophy Room -->
  <div class="trophy-panel glass-panel">
    <div class="trophy-header">
      <div class="trophy-title">
        <span>🏆 Unlocked Achievements & Badges</span>
      </div>
      <span class="trophy-count" id="dash-badge-count">1 of 15 Badges Unlocked</span>
    </div>

    <div class="badges-grid" id="dash-badges-container">
      <!-- Populated via JS -->
    </div>
  </div>

  <!-- Recent History Table -->
  <div class="history-panel glass-panel">
    <div class="history-header">
      <h3>Recent Test Log</h3>
    </div>
    <div class="table-container">
      <table class="history-table">
        <thead>
          <tr>
            <th>Date & Time</th>
            <th>Language</th>
            <th>Mode</th>
            <th>WPM</th>
            <th>Accuracy</th>
            <th>Errors</th>
          </tr>
        </thead>
        <tbody id="dash-history-tbody">
          <!-- Populated via JS -->
        </tbody>
      </table>
    </div>
  </div>
</div>

<style is:global>
  .dashboard-wrapper {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 20px 0;
  }

  /* Account Sync & Guest Status Banner */
  .account-sync-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: clamp(16px, 2.5vw, 22px) clamp(18px, 3vw, 28px);
    background: linear-gradient(135deg, rgba(0, 112, 243, 0.08), rgba(121, 40, 202, 0.08));
    border: 1px solid rgba(0, 112, 243, 0.25);
    border-radius: var(--radius-lg, 16px);
    position: relative;
    overflow: hidden;
  }

  .acc-sync-left {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 1;
  }

  .acc-sync-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(0, 112, 243, 0.2), rgba(121, 40, 202, 0.2));
    border: 1px solid rgba(0, 112, 243, 0.4);
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(0, 112, 243, 0.2);
  }

  .acc-sync-icon {
    font-size: 24px;
    line-height: 1;
  }

  .acc-sync-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .acc-sync-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .acc-sync-title-row strong {
    font-size: clamp(15px, 2vw, 17px);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.2px;
  }

  .acc-status-pill {
    font-size: 11px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.35);
  }

  .acc-status-pill.is-active {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    border-color: rgba(16, 185, 129, 0.35);
  }

  .acc-sync-info p {
    font-size: 13.5px;
    color: var(--text-muted);
    line-height: 1.45;
    margin: 0;
  }

  .acc-sync-right {
    flex-shrink: 0;
  }

  .acc-sync-cta-btn {
    white-space: nowrap;
    padding: 10px 22px;
    font-size: 13.5px;
    font-weight: 700;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 16px rgba(0, 112, 243, 0.3);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .acc-sync-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 112, 243, 0.45);
  }

  @media (max-width: 768px) {
    .account-sync-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding: 16px;
    }
    .acc-sync-left {
      align-items: flex-start;
    }
    .acc-sync-right {
      width: 100%;
    }
    .acc-sync-cta-btn {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }

  /* Light Theme Account Sync Banner Overrides */
  [data-theme='light'] .account-sync-banner {
    background: #ffffff !important;
    border-color: #e2e8f0 !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05) !important;
  }

  [data-theme='light'] .acc-sync-title-row strong {
    color: #0f172a !important;
  }

  [data-theme='light'] .acc-sync-info p {
    color: #475569 !important;
  }

  [data-theme='light'] .acc-sync-icon-wrapper {
    background: #eff6ff !important;
    border-color: #bfdbfe !important;
    box-shadow: 0 2px 8px rgba(0, 112, 243, 0.1) !important;
  }

  .level-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 28px;
    background: linear-gradient(135deg, rgba(18, 27, 46, 0.9), rgba(0, 240, 255, 0.08));
    border: 1px solid rgba(0, 240, 255, 0.3);
  }

  .level-left {
    display: flex;
    align-items: center;
    gap: 24px;
    flex: 1;
  }

  .level-badge-large {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(0, 240, 255, 0.15) 0%, rgba(8, 14, 26, 0.9) 100%);
    border: 2px solid var(--accent-cyan);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 20px var(--accent-cyan-glow);
  }

  .level-num {
    font-size: 32px;
    font-weight: 900;
    font-family: var(--font-mono);
    line-height: 1;
    color: var(--accent-cyan, #00f0ff);
    text-shadow: 0 0 10px rgba(0, 240, 255, 0.4);
  }

  .level-lbl {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.8px;
    color: var(--text-main, #ffffff);
  }

  .level-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    max-width: 500px;
  }

  .level-title-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .level-title {
    font-size: 22px;
    font-weight: 800;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
  }

  .dash-user-avatar {
    font-size: 22px;
    margin-right: 4px;
    filter: drop-shadow(0 0 6px rgba(0, 240, 255, 0.4));
  }

  .dash-user-name {
    font-weight: 900;
    color: #ffffff;
  }

  .dash-rank-badge {
    font-size: 16px;
    font-weight: 700;
    color: var(--accent-cyan, #00f0ff);
  }

  .level-title-mr {
    font-size: 14px;
    color: var(--accent-cyan);
  }

  .xp-bar-container {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .xp-bar-track {
    height: 10px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    overflow: hidden;
  }

  .xp-bar-glow {
    height: 100%;
    background: linear-gradient(to right, var(--accent-cyan), var(--accent-gold));
    border-radius: 6px;
    box-shadow: 0 0 10px var(--accent-cyan-glow);
  }

  .xp-text-row {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 600;
  }

  .streak-box {
    display: flex;
    gap: 20px;
  }

  .streak-stat {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-radius: var(--radius-md);
    background: rgba(8, 12, 20, 0.6);
    border: 1px solid var(--border-subtle);
  }

  .streak-icon {
    font-size: 24px;
  }

  .streak-val {
    font-size: 20px;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    display: block;
    line-height: 1;
  }

  .streak-lbl {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .btn-profile-hub {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(0, 240, 255, 0.2), rgba(0, 112, 243, 0.2));
    border: 1.5px solid rgba(0, 240, 255, 0.5);
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    padding: 6px 12px;
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.25);
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-profile-hub:hover {
    background: linear-gradient(135deg, rgba(0, 240, 255, 0.35), rgba(0, 112, 243, 0.35));
    border-color: #00f0ff;
    box-shadow: 0 0 18px rgba(0, 240, 255, 0.45);
    transform: translateY(-1px);
  }

  .bests-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .best-card {
    padding: 24px;
  }

  .border-cyan { border-color: rgba(0, 240, 255, 0.3); }
  .border-pink { border-color: rgba(255, 0, 122, 0.3); }

  .best-card-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  .best-card-header h3 {
    font-size: 18px;
    font-weight: 800;
    color: #ffffff;
  }

  .best-stats-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 12px;
  }

  .best-stat {
    background: rgba(8, 12, 20, 0.6);
    border: 1px solid var(--border-subtle);
    padding: 14px;
    border-radius: var(--radius-md);
    text-align: center;
  }

  .val-big {
    font-size: 26px;
    font-weight: 900;
    font-family: var(--font-mono);
    color: var(--text-main);
    display: block;
  }

  .lbl-small {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-top: 4px;
    display: block;
  }

  /* Chart Panel */
  .chart-panel {
    padding: 24px;
  }

  .chart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .chart-title {
    font-size: 16px;
    font-weight: 800;
    color: #ffffff;
  }

  .chart-subtitle {
    font-size: 13px;
    color: var(--text-muted);
  }

  .chart-svg-wrapper {
    width: 100%;
    height: 220px;
    background: rgba(8, 12, 20, 0.7);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    padding: 12px;
  }

  .wpm-svg {
    width: 100%;
    height: 100%;
  }

  /* Badges Trophy Grid */
  .trophy-panel {
    padding: clamp(18px, 2.5vw, 28px);
    background: linear-gradient(180deg, rgba(12, 17, 32, 0.95) 0%, rgba(6, 10, 20, 0.98) 100%);
    border: 1.5px solid rgba(0, 240, 255, 0.25);
    border-radius: var(--radius-xl);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .trophy-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 22px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
    gap: 10px;
  }

  .trophy-title {
    font-size: clamp(16px, 2vw, 19px);
    font-weight: 900;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.3px;
  }

  .trophy-count {
    font-size: 12px;
    color: var(--accent-cyan);
    font-weight: 800;
    background: rgba(0, 240, 255, 0.12);
    border: 1px solid rgba(0, 240, 255, 0.35);
    padding: 5px 14px;
    border-radius: 20px;
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.2);
    letter-spacing: 0.4px;
  }

  .badges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 16px;
  }

  .badge-card-item {
    padding: 16px;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* Unlocked Badge - Cyan Cyber Glow */
  .badge-card-item.unlocked {
    background: linear-gradient(145deg, #10192e 0%, #0a0f1d 100%);
    border: 1.5px solid rgba(0, 240, 255, 0.4);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.6), 0 0 16px rgba(0, 240, 255, 0.15), inset 0 1px 0 rgba(0, 240, 255, 0.2);
  }

  .badge-card-item.unlocked::before {
    content: '';
    position: absolute;
