  [data-theme='light'] .lb-tabs-bg-shape {
    background: radial-gradient(circle at 50% 50%, rgba(0, 112, 243, 0.05), transparent 70%) !important;
  }

  [data-theme='light'] .lb-cat-btn,
  [data-theme='light'] .lb-category-tabs .pill-btn {
