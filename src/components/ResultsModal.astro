---
---

<div id="results-modal" class="results-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="res-headline">
  <div class="results-card">
    <!-- Header -->
    <div class="results-header">
      <div id="res-badge-status" class="status-badge">🏆 Test Completed</div>
      <h2 id="res-headline" class="results-title">Outstanding Performance!</h2>
      <p id="res-subheadline" class="results-sub">Here is your speed and accuracy breakdown</p>
    </div>

    <!-- Personal Best Banner -->
    <div id="res-pb-banner" class="pb-banner hidden">
      <div class="pb-banner-content">
        <span class="flame-icon">🔥</span>
        <div class="pb-banner-text">
          <strong class="pb-title">NEW PERSONAL RECORD!</strong>
          <span class="pb-desc">You just set your all-time highest WPM speed!</span>
        </div>
      </div>
    </div>

    <!-- Main Score Metrics Grid -->
    <div class="metrics-grid">
      <!-- WPM Card -->
      <div class="metric-box primary-box">
        <span class="metric-label">Typing Speed</span>
        <div class="metric-main">
          <span id="res-wpm-val" class="metric-huge">72</span>
          <span class="metric-unit">WPM</span>
        </div>
        <span id="res-net-wpm" class="metric-note">Net: 68 WPM</span>
      </div>

      <!-- Accuracy Card -->
      <div class="metric-box accuracy-box">
        <span class="metric-label">Accuracy</span>
        <div class="metric-main">
          <span id="res-acc-val" class="metric-large">98.2</span>
          <span class="metric-unit">%</span>
        </div>
        <span id="res-mistakes-val" class="metric-note text-mistakes">2 Mistakes</span>
      </div>

      <!-- Time & Chars Card -->
      <div class="metric-box time-box">
        <span class="metric-label">Total Time</span>
        <div class="metric-main">
          <span id="res-time-val" class="metric-large">60</span>
          <span class="metric-unit">sec</span>
        </div>
        <span id="res-chars-val" class="metric-note">340 Chars</span>
      </div>
    </div>

    <!-- User Profile & XP Progression Card -->
    <div class="res-user-xp-card">
      <div class="res-user-header-row">
        <div class="res-user-info">
          <span class="res-user-avatar" id="res-user-avatar">🏎️</span>
          <div class="res-user-meta">
            <div class="res-user-name" id="res-user-name">Guest Player</div>
            <div class="res-user-level-sub">
              Level <span id="res-lvl-val">1</span> &bull; <span id="res-rank-val">Keyboard Rookie</span>
            </div>
          </div>
        </div>
        <div class="res-xp-gain-badge">
          <span>⚡</span>
          <strong>+<span id="res-xp-val">25</span> XP</strong>
        </div>
      </div>

      <!-- XP Bar -->
      <div class="res-xp-bar-wrapper">
        <div class="xp-bar-bg">
          <div id="res-xp-bar" class="xp-bar-fill" style="width: 30%;"></div>
        </div>
      </div>
    </div>

    <!-- New Badges Unlocked Container -->
    <div id="res-badges-box" class="new-badges-box hidden">
      <span class="badge-box-title">🎖️ New Achievement Unlocked:</span>
      <div id="res-badges-list" class="badge-items-row"></div>
    </div>

    <!-- Viral Social Share Section -->
    <div class="res-viral-share-box">
      <span class="share-title">🔥 Challenge Your Friends:</span>
      <div class="share-buttons-row">
        <button type="button" id="res-btn-share-whatsapp" class="res-share-btn share-whatsapp" title="Share your score on WhatsApp">
          <span>💬 WhatsApp</span>
        </button>
        <button type="button" id="res-btn-share-x" class="res-share-btn share-x" title="Post your score on X / Twitter">
          <span>𝕏 Post</span>
        </button>
        <button type="button" id="res-btn-share-telegram" class="res-share-btn share-telegram" title="Share your score on Telegram">
          <span>✈️ Telegram</span>
        </button>
        <button type="button" id="res-btn-copy-challenge" class="res-share-btn share-copy" title="Copy challenge link to clipboard">
          <span id="res-copy-text">🔗 Copy Link</span>
        </button>
      </div>
    </div>

    <!-- Action Buttons for Continuous Engagement -->
    <div class="results-actions">
      <button type="button" id="res-btn-retry" class="btn-primary res-action-btn" data-analytics-cta="results_retry" title="Practice test again">
        <span>🔄 Practice Again</span>
      </button>
      <button type="button" id="res-btn-race" class="btn-secondary res-action-btn" data-analytics-cta="results_next_race" title="Race against the AI Bot">
        <span>🏎️ Race AI</span>
      </button>
      <a href="/daily-challenge" id="res-btn-daily" class="btn-secondary res-action-btn" data-analytics-cta="results_next_daily" title="Play Today's Daily Streak Challenge">
        <span>🔥 Daily Challenge</span>
      </a>
      <a href="/leaderboard" id="res-btn-lb" class="btn-secondary res-action-btn" data-analytics-cta="results_next_leaderboard" title="View Your Leaderboard Rank">
        <span>🏆 Leaderboard</span>
      </a>
      <button type="button" id="res-btn-exit" class="btn-secondary btn-exit-action res-action-btn" title="Close and return to typing arena">
        <span>✕ Exit</span>
      </button>
    </div>

    <!-- Unobtrusive Guest Cloud Sync Hint -->
    <div id="res-guest-hint" class="res-guest-hint" style="display: none;">
      <span>Playing as Guest &bull; <button type="button" id="res-guest-save-btn" class="res-guest-link">Sign in to save streak &amp; scores</button></span>
    </div>
  </div>
</div>

<style is:global>
  .results-overlay {
    position: fixed;
    inset: 0;
    background: rgba(4, 7, 14, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 9999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 4vh, 36px) 16px;
    opacity: 1;
    transition: all var(--transition-smooth, 0.2s ease);
    box-sizing: border-box;
  }

  .results-overlay.hidden {
    display: none !important;
    opacity: 0;
  }

  .results-card {
    background: #0d1424;
    border: 1.5px solid rgba(0, 240, 255, 0.35);
    border-radius: var(--radius-xl, 20px);
    width: 100%;
    max-width: 580px;
    padding: 28px 24px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8), 0 0 40px rgba(0, 240, 255, 0.15);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    animation: resZoomIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
  }

  @keyframes resZoomIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .results-header {
    text-align: center;
    position: relative;
  }

  .status-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 20px;
    background: rgba(0, 240, 255, 0.12);
    border: 1px solid rgba(0, 240, 255, 0.3);
    color: var(--accent-cyan, #00f0ff);
    font-size: 11.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 6px;
  }

  .results-title {
    font-size: 23px;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.2;
  }

  .results-sub {
    font-size: 13.5px;
    color: var(--text-muted, #94a3b8);
    margin: 4px 0 0 0;
  }

  /* 1. Personal Best Banner */
  .pb-banner {
    border-radius: 14px;
    padding: 10px 14px;
    background: linear-gradient(135deg, rgba(244, 114, 182, 0.25) 0%, rgba(56, 189, 248, 0.25) 100%);
    border: 1.5px solid #38bdf8;
    box-shadow: 0 4px 16px rgba(0, 240, 255, 0.2);
    animation: pbGlowPulse 2.5s infinite ease-in-out;
  }

  .pb-banner-content {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pb-banner .flame-icon {
    font-size: 24px;
    flex-shrink: 0;
    filter: drop-shadow(0 0 8px rgba(245, 158, 11, 0.6));
  }

  .pb-banner-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }

  .pb-title {
    font-size: 13.5px;
    font-weight: 900;
    letter-spacing: 0.5px;
    color: #ffffff;
  }

  .pb-desc {
    font-size: 12px;
    font-weight: 600;
    color: #67e8f9;
  }

  @keyframes pbGlowPulse {
    0%, 100% { box-shadow: 0 4px 14px rgba(56, 189, 248, 0.2); }
    50% { box-shadow: 0 4px 22px rgba(244, 114, 182, 0.4); }
  }

  /* 2. Main Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .metric-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg, 14px);
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2px;
  }

  .metric-label {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--text-muted, #94a3b8);
  }

  .metric-main {
    display: flex;
    align-items: baseline;
    gap: 3px;
  }

  .metric-huge {
    font-size: 36px;
    font-weight: 900;
    line-height: 1;
    font-family: var(--font-mono, monospace);
    color: var(--accent-cyan, #00f0ff);
  }

  .metric-large {
    font-size: 26px;
    font-weight: 900;
    line-height: 1.1;
    font-family: var(--font-mono, monospace);
    color: #10b981;
  }

  .metric-unit {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-muted, #94a3b8);
  }

  .metric-note {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--text-muted, #94a3b8);
    margin-top: 2px;
  }

  .text-mistakes {
    color: #f87171 !important;
  }

  /* 3. User Profile & XP Card */
  .res-user-xp-card {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg, 14px);
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .res-user-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  .res-user-info {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex: 1;
  }

  .res-user-avatar {
    font-size: 26px;
    line-height: 1;
    flex-shrink: 0;
  }

  .res-user-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .res-user-name {
    font-size: 15px;
    font-weight: 900;
    color: #ffffff;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .res-user-level-sub {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--accent-cyan, #00f0ff);
    margin-top: 2px;
  }

  .res-xp-gain-badge {
    display: flex;
    align-items: center;
    gap: 4px;
    background: rgba(251, 191, 36, 0.18);
    border: 1px solid rgba(251, 191, 36, 0.4);
    color: #fbbf24;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 12.5px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .res-xp-bar-wrapper {
    width: 100%;
  }

  .xp-bar-bg {
    width: 100%;
    height: 8px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    overflow: hidden;
  }

  .xp-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #00f0ff, #fbbf24);
    border-radius: 4px;
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Badges Unlocked Section */
  .new-badges-box {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    border-radius: var(--radius-md, 10px);
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .badge-box-title {
    font-size: 12px;
    font-weight: 800;
    color: #10b981;
  }

  .badge-items-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* Action Buttons - 3-Button Symmetrical Layout */
  .results-actions {
    display: grid;
    grid-template-columns: 1.2fr 1fr 0.8fr;
    gap: 10px;
    margin-top: 10px;
    width: 100%;
    box-sizing: border-box;
  }

  .results-actions .res-action-btn {
    width: 100% !important;
    min-height: 46px;
    padding: 10px 14px !important;
    font-size: 14.5px !important;
    font-weight: 800 !important;
    border-radius: 12px !important;
    cursor: pointer;
    box-sizing: border-box;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    transition: all 0.2s ease;
    white-space: nowrap;
    text-align: center;
  }

  .btn-exit-action {
    background: rgba(239, 68, 68, 0.08) !important;
    border: 1.5px solid rgba(239, 68, 68, 0.3) !important;
    color: #ef4444 !important;
  }

  .btn-exit-action:hover {
    background: rgba(239, 68, 68, 0.16) !important;
    border-color: #ef4444 !important;
  }

  /* Viral Social Share Styling */
  .res-viral-share-box {
    width: 100%;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px dashed rgba(255, 255, 255, 0.12);
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-sizing: border-box;
  }

  .share-title {
    font-size: 12px;
    font-weight: 800;
    color: var(--accent-gold, #fbbf24);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: left;
  }

  .share-buttons-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    width: 100%;
  }

  .res-share-btn {
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    white-space: nowrap;
  }

  .share-whatsapp {
    background: rgba(37, 211, 102, 0.15);
    color: #25d366;
    border-color: rgba(37, 211, 102, 0.4);
  }
  .share-whatsapp:hover {
    background: #25d366;
    color: #000;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);
  }

  .share-x {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.25);
  }
  .share-x:hover {
    background: #ffffff;
    color: #000000;
    transform: translateY(-2px);
  }

  .share-telegram {
    background: rgba(0, 136, 204, 0.15);
    color: #0088cc;
    border-color: rgba(0, 136, 204, 0.4);
  }
  .share-telegram:hover {
    background: #0088cc;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0, 136, 204, 0.3);
  }

  .share-copy {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border-color: rgba(168, 85, 247, 0.4);
  }
  .share-copy:hover {
    background: #a855f7;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(168, 85, 247, 0.3);
  }

  [data-theme='light'] .res-viral-share-box {
    background: #f8fafc;
    border-color: #cbd5e1;
  }

  [data-theme='light'] .share-x {
    background: #f1f5f9;
    color: #0f172a;
    border-color: #cbd5e1;
  }
  [data-theme='light'] .share-x:hover {
    background: #0f172a;
    color: #ffffff;
  }

  /* Responsive Rules */
  @media (max-width: 580px) {
    .results-card {
      padding: 20px 16px;
      gap: 14px;
    }
    .metrics-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .metric-box {
      padding: 10px 6px;
    }
    .metric-huge {
      font-size: 28px;
    }
    .metric-large {
      font-size: 22px;
    }
    .results-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      width: 100%;
    }
    .results-actions .btn-exit-action {
      grid-column: span 2;
    }
    .results-actions .res-action-btn {
      padding: 10px 12px !important;
      font-size: 13.5px !important;
      min-height: 44px;
    }
    .share-buttons-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 360px) {
    .results-actions {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .results-actions .btn-exit-action {
      grid-column: span 1;
    }
  }

  @media (max-width: 400px) {
    .metrics-grid {
      grid-template-columns: 1fr 1fr;
    }
    .metrics-grid .metric-box:last-child {
      grid-column: span 2;
    }
  }

  /* =========================================================================
     LIGHT THEME RESULT MODAL OVERRIDES (High Contrast, Crisp & Beautiful)
     ========================================================================= */
  [data-theme='light'] .results-card {
    background: #ffffff !important;
    border: 1.5px solid #e2e8f0 !important;
    box-shadow: 0 25px 70px rgba(15, 23, 42, 0.22) !important;
  }

  [data-theme='light'] .results-title {
    color: #0f172a !important;
    font-weight: 900 !important;
  }

  [data-theme='light'] .results-sub {
    color: #475569 !important;
    font-weight: 600 !important;
  }

  /* 1. Personal Best Banner in Light Theme */
  [data-theme='light'] .pb-banner {
    background: linear-gradient(135deg, #fce7f3 0%, #e0f2fe 100%) !important;
    border: 1.5px solid #38bdf8 !important;
    box-shadow: 0 4px 14px rgba(0, 112, 243, 0.12) !important;
  }

  [data-theme='light'] .pb-title {
    color: #0b1e36 !important;
    font-weight: 900 !important;
  }

  [data-theme='light'] .pb-desc {
    color: #1e3a8a !important;
    font-weight: 700 !important;
  }

  /* 2. Metrics in Light Theme */
  [data-theme='light'] .metric-box {
    background: #ffffff !important;
    border: 1.5px solid #e2e8f0 !important;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04) !important;
  }

  [data-theme='light'] .metric-label {
    color: #0f172a !important;
    font-weight: 800 !important;
  }

  [data-theme='light'] .primary-box .metric-huge {
    color: #0070f3 !important;
    font-weight: 900 !important;
  }

  [data-theme='light'] .primary-box .metric-note {
    color: #0070f3 !important;
    background: #eff6ff !important;
    padding: 2px 8px;
    border-radius: 6px;
    font-weight: 800 !important;
  }

  [data-theme='light'] .accuracy-box .metric-large {
    color: #059669 !important;
    font-weight: 900 !important;
  }

  [data-theme='light'] .accuracy-box .text-mistakes {
    color: #dc2626 !important;
    background: #fef2f2 !important;
    padding: 2px 8px;
    border-radius: 6px;
    font-weight: 800 !important;
  }

  [data-theme='light'] .time-box .metric-large {
    color: #4338ca !important;
    font-weight: 900 !important;
  }

  [data-theme='light'] .time-box .metric-note {
    color: #475569 !important;
    font-weight: 700 !important;
  }

  /* 3. User Card in Light Theme */
  [data-theme='light'] .res-user-xp-card {
    background: #f8fafc !important;
    border: 1.5px solid #e2e8f0 !important;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04) !important;
  }

  [data-theme='light'] .res-user-name {
    color: #0f172a !important;
    font-weight: 900 !important;
  }

  [data-theme='light'] .res-user-level-sub {
    color: #0070f3 !important;
    font-weight: 700 !important;
  }

  [data-theme='light'] .res-xp-gain-badge {
    background: #fffbeb !important;
    border: 1.5px solid #fde68a !important;
    color: #b45309 !important;
    font-weight: 900 !important;
  }

  [data-theme='light'] .xp-bar-bg {
    background: #e2e8f0 !important;
  }

  [data-theme='light'] .xp-bar-fill {
    background: linear-gradient(90deg, #0070f3, #f59e0b) !important;
  }

  /* Action Buttons in Light Theme */
  [data-theme='light'] .results-actions .btn-primary {
    background: #0070f3 !important;
    color: #ffffff !important;
    box-shadow: 0 4px 14px rgba(0, 112, 243, 0.25) !important;
  }

  [data-theme='light'] .results-actions .btn-secondary {
    background: #ffffff !important;
    color: #0f172a !important;
    border: 1.5px solid #cbd5e1 !important;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04) !important;
  }

  .res-guest-hint {
    text-align: center;
    font-size: 12px;
    color: #94a3b8;
    margin-top: 4px;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .res-guest-link {
    background: transparent;
    border: none;
    color: #00f0ff;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: underline;
    padding: 0;
  }

  [data-theme='light'] .res-guest-hint {
    color: #64748b !important;
    border-color: #e2e8f0 !important;
  }

  [data-theme='light'] .res-guest-link {
    color: #0284c7 !important;
  }
</style>

<script>
  import { StorageManager } from '../lib/storage';
  import { AuthManager } from '../lib/auth';
  import { getLevelInfo, BADGES } from '../lib/gamification';

  const modal = document.getElementById('results-modal');
  const retryBtn = document.getElementById('res-btn-retry');
  const raceBtn = document.getElementById('res-btn-race');
  const exitBtn = document.getElementById('res-btn-exit');
  const guestSaveBtn = document.getElementById('res-guest-save-btn');

  const wpmVal = document.getElementById('res-wpm-val');
  const netWpmVal = document.getElementById('res-net-wpm');
  const accVal = document.getElementById('res-acc-val');
  const mistakesVal = document.getElementById('res-mistakes-val');
  const timeVal = document.getElementById('res-time-val');
  const charsVal = document.getElementById('res-chars-val');

  const userNameEl = document.getElementById('res-user-name');
  const userAvatarEl = document.getElementById('res-user-avatar');
  const xpVal = document.getElementById('res-xp-val');
  const lvlVal = document.getElementById('res-lvl-val');
  const rankVal = document.getElementById('res-rank-val');
  const xpBar = document.getElementById('res-xp-bar');
  const pbBanner = document.getElementById('res-pb-banner');
  const badgesBox = document.getElementById('res-badges-box');
  const badgesList = document.getElementById('res-badges-list');
  const guestHint = document.getElementById('res-guest-hint');

  let currentResultData: any = null;

  function handleDisplayResults(rawResult: any, options?: { isPersonalBest?: boolean; xpGained?: number; newBadges?: string[] }) {
    if (!rawResult) return;

    let stats = StorageManager.getStats();
    let isPersonalBest = options?.isPersonalBest ?? false;
    let xpGained = options?.xpGained ?? 25;
    let newBadges = options?.newBadges ?? [];

    if (!options) {
      const recorded = StorageManager.recordTestResult(rawResult);
      stats = recorded.stats;
      isPersonalBest = recorded.isPersonalBest;
      xpGained = recorded.xpGained;
      newBadges = recorded.newBadges;
    }

    const settings = StorageManager.getSettings();
    const levelInfo = getLevelInfo(stats.xp);
    const profile = AuthManager.getUserProfile();
    const dynamicName = (profile.isRegistered && profile.username) ? profile.username : ((settings.userName && settings.userName.trim()) ? settings.userName : 'Guest Player');
    const dynamicAvatar = profile.isRegistered ? (profile.avatar || '🏎️') : (settings.userAvatar || '👤');

    currentResultData = {
      ...rawResult,
      id: 'res_' + Date.now(),
      timestamp: Date.now(),
      isPersonalBest
    };

    // Populate Metrics
    if (wpmVal) wpmVal.textContent = String(rawResult.wpm);
    if (netWpmVal) netWpmVal.textContent = `Net: ${rawResult.netWpm} WPM`;
    if (accVal) accVal.textContent = String(rawResult.accuracy);
    if (mistakesVal) mistakesVal.textContent = `${rawResult.errors} Mistakes`;
    if (timeVal) timeVal.textContent = String(rawResult.durationSec || 60);
    if (charsVal) {
      const totalChars = Math.round((rawResult.wpm * 5 * (rawResult.durationSec || 60)) / 60);
      charsVal.textContent = `${totalChars} Chars`;
    }

    // Personal Best Banner
    if (pbBanner) {
      if (isPersonalBest) pbBanner.classList.remove('hidden');
      else pbBanner.classList.add('hidden');
    }

    // Dynamic User & Level Information
    if (userNameEl) userNameEl.textContent = dynamicName;
    if (userAvatarEl) userAvatarEl.textContent = dynamicAvatar;
    if (xpVal) xpVal.textContent = String(xpGained);
    if (lvlVal) lvlVal.textContent = String(levelInfo.level);
    if (rankVal) rankVal.textContent = levelInfo.title;
    if (xpBar) xpBar.style.width = `${levelInfo.progressPercent}%`;

    // Guest Hint Display
    if (guestHint) {
      guestHint.style.display = AuthManager.isGuest() ? 'block' : 'none';
    }

    if (guestSaveBtn) {
      guestSaveBtn.onclick = () => {
        if (typeof (window as any).openTypeBaaziAuthModal === 'function') {
          (window as any).openTypeBaaziAuthModal('signup');
        }
      };
    }

    // Badges Unlocked Container
    if (badgesBox && badgesList) {
      if (newBadges.length > 0) {
        badgesBox.classList.remove('hidden');
        badgesList.innerHTML = newBadges.map(bid => {
          const bdef = BADGES.find(b => b.id === bid);
          return `<span class="badge badge-green">${bdef?.icon || '🎖️'} ${bdef?.name || 'Unlocked!'}</span>`;
        }).join('');
      } else {
        badgesBox.classList.add('hidden');
      }
    }

    modal?.classList.remove('hidden');

    // Fire GA4 complete_typing_test telemetry
    try {
      if (typeof (window as any).trackTypeBaaziEvent === 'function') {
        (window as any).trackTypeBaaziEvent('complete_typing_test', {
          wpm: rawResult.wpm,
          net_wpm: rawResult.netWpm,
          accuracy: rawResult.accuracy,
          errors: rawResult.errors,
          duration: rawResult.durationSec || 60,
          language: rawResult.language || 'english',
          is_personal_best: isPersonalBest,
          xp_gained: xpGained
        });
      }
    } catch (err) {
      console.warn('Analytics event error:', err);
    }

    // Attach Viral Share Handlers with dynamic test metrics & UTM parameters
    const baseShareUrl = 'https://typebaazi.com/typing-test';
    const waShareUrl = `${baseShareUrl}?utm_source=whatsapp&utm_medium=social_share&utm_campaign=typing_score`;
    const xShareUrl = `${baseShareUrl}?utm_source=twitter&utm_medium=social_share&utm_campaign=typing_score`;
    const tgShareUrl = `${baseShareUrl}?utm_source=telegram&utm_medium=social_share&utm_campaign=typing_score`;
    const copyShareUrl = `${baseShareUrl}?utm_source=copy_link&utm_medium=social_share&utm_campaign=typing_score`;

    const shareTextWA = `🔥 I just scored ${rawResult.wpm} WPM with ${rawResult.accuracy}% accuracy in ${rawResult.language || 'English'} typing on TypeBaazi! 🏎️ Can you beat my score? Take the free challenge here: ${waShareUrl}`;
    const shareTextTG = `🔥 I just scored ${rawResult.wpm} WPM with ${rawResult.accuracy}% accuracy in ${rawResult.language || 'English'} typing on TypeBaazi! 🏎️ Can you beat my score? Take the free challenge here: ${tgShareUrl}`;
    const shareTextCopy = `🔥 I just scored ${rawResult.wpm} WPM with ${rawResult.accuracy}% accuracy in ${rawResult.language || 'English'} typing on TypeBaazi! 🏎️ Can you beat my score? Take the free challenge: ${copyShareUrl}`;

    const btnWhatsapp = document.getElementById('res-btn-share-whatsapp');
    const btnX = document.getElementById('res-btn-share-x');
    const btnTelegram = document.getElementById('res-btn-share-telegram');
    const btnCopy = document.getElementById('res-btn-copy-challenge');
    const copyTextSpan = document.getElementById('res-copy-text');

    if (btnWhatsapp) {
      btnWhatsapp.onclick = () => {
        try {
          if (typeof (window as any).trackTypeBaaziEvent === 'function') {
            (window as any).trackTypeBaaziEvent('share_result', { channel: 'whatsapp', wpm: rawResult.wpm, accuracy: rawResult.accuracy });
          }
        } catch {}
        const waUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(shareTextWA)}`;
        window.open(waUrl, '_blank', 'noopener,noreferrer');
      };
    }

    if (btnX) {
      btnX.onclick = () => {
        try {
          if (typeof (window as any).trackTypeBaaziEvent === 'function') {
            (window as any).trackTypeBaaziEvent('share_result', { channel: 'twitter', wpm: rawResult.wpm, accuracy: rawResult.accuracy });
          }
        } catch {}
        const tweetText = `⚡ Just typed ${rawResult.wpm} WPM (${rawResult.accuracy}% accuracy) on @TypeBaazi! 🏎️ Think you can beat me? Test your speed:`;
        const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(tweetText)}&url=${encodeURIComponent(xShareUrl)}&hashtags=TypeBaazi,TypingTest,TouchTyping`;
        window.open(xUrl, '_blank', 'noopener,noreferrer');
      };
    }

    if (btnTelegram) {
      btnTelegram.onclick = () => {
        try {
          if (typeof (window as any).trackTypeBaaziEvent === 'function') {
            (window as any).trackTypeBaaziEvent('share_result', { channel: 'telegram', wpm: rawResult.wpm, accuracy: rawResult.accuracy });
          }
        } catch {}
        const tgUrl = `https://t.me/share/url?url=${encodeURIComponent(tgShareUrl)}&text=${encodeURIComponent(shareTextTG)}`;
        window.open(tgUrl, '_blank', 'noopener,noreferrer');
      };
    }

    if (btnCopy) {
      btnCopy.onclick = async () => {
        try {
          if (typeof (window as any).trackTypeBaaziEvent === 'function') {
            (window as any).trackTypeBaaziEvent('share_result', { channel: 'copy_link', wpm: rawResult.wpm, accuracy: rawResult.accuracy });
          }
        } catch {}
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(shareTextCopy);
          } else {
            const tempInput = document.createElement('textarea');
            tempInput.value = shareTextCopy;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
          }
          if (copyTextSpan) {
            copyTextSpan.textContent = '✓ Copied!';
            setTimeout(() => {
              if (copyTextSpan) copyTextSpan.textContent = '🔗 Copy Link';
            }, 2500);
          }
        } catch (err) {
          console.warn('Clipboard copy error:', err);
        }
      };
    }
  }

  window.addEventListener('show-test-results', (e: Event) => {
    const custom = e as CustomEvent<{ result: any }>;
    if (custom.detail && custom.detail.result) {
      handleDisplayResults(custom.detail.result);
    }
  });

  window.addEventListener('test-completed', (e: Event) => {
    const custom = e as CustomEvent<{
      result: any;
      xpGained?: number;
      isPersonalBest?: boolean;
      newBadges?: string[];
    }>;
    if (custom.detail && custom.detail.result) {
      handleDisplayResults(custom.detail.result, {
        isPersonalBest: custom.detail.isPersonalBest,
        xpGained: custom.detail.xpGained,
        newBadges: custom.detail.newBadges
      });
    }
  });

  retryBtn?.addEventListener('click', () => {
    modal?.classList.add('hidden');
    window.dispatchEvent(new CustomEvent('restart-active-test'));
  });

  raceBtn?.addEventListener('click', () => {
    window.location.href = '/race';
  });

  exitBtn?.addEventListener('click', () => {
    modal?.classList.add('hidden');
    window.dispatchEvent(new CustomEvent('exit-test-results'));
  });

  // Tab + Enter shortcut to retry
  window.addEventListener('keydown', (e) => {
    if (!modal || modal.classList.contains('hidden')) return;
    if (e.key === 'Enter' || (e.key === 'Tab' && e.shiftKey)) {
      e.preventDefault();
      modal.classList.add('hidden');
      window.dispatchEvent(new CustomEvent('restart-active-test'));
    }
  });
</script>
