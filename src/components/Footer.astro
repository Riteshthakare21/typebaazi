<style is:global>
  .footer-wrapper {
    background: #060911;
    border-top: 1px solid var(--border-subtle);
    padding: 60px 0 24px;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1fr 1fr;
    gap: 32px;
    margin-bottom: 48px;
  }

  .footer-logo {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 12px;
  }

  .logo-text {
    font-size: 22px;
    font-weight: 800;
    color: #ffffff;
  }

  .logo-mr {
    font-size: 13px;
    font-weight: 700;
    color: var(--accent-cyan);
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(0, 240, 255, 0.1);
  }

  .text-cyan {
    color: var(--accent-cyan);
  }

  .brand-desc {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 16px;
    max-width: 360px;
  }

  .privacy-badge {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    font-size: 12px;
    color: #cbd5e1;
    line-height: 1.4;
  }

  .shield-icon {
    font-size: 14px;
  }

  .col-title {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 16px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    color: var(--text-muted);
    font-size: 14px;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--accent-cyan);
    text-decoration: underline;
  }

  .footer-links a.apk-footer-link {
    color: var(--accent-cyan);
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .footer-links a.apk-footer-link:hover {
    color: #ffffff;
    text-shadow: 0 0 10px var(--accent-cyan);
    text-decoration: underline;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
    font-size: 13px;
    color: var(--text-subtle);
  }

  .legal-mini-links {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    flex-wrap: wrap;
  }

  .legal-mini-links a {
    color: var(--text-muted, #94a3b8);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .legal-mini-links a:hover {
    color: var(--accent-cyan, #00f0ff);
    text-decoration: underline;
  }

  .tech-stack-tag {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .brand-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .brand-col {
      grid-column: span 1;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }

  /* Light Theme Footer Styling */
  [data-theme='light'] .footer-wrapper {
    background: #f8fafc !important;
    border-top: 1px solid #e2e8f0 !important;
  }

  [data-theme='light'] .logo-text {
    color: #0f172a !important;
  }

  [data-theme='light'] .col-title {
    color: #0f172a !important;
    font-weight: 800 !important;
  }

  [data-theme='light'] .footer-links a {
    color: #475569 !important;
    font-weight: 500;
  }

  [data-theme='light'] .footer-links a:hover {
    color: #0070f3 !important;
  }

  [data-theme='light'] .footer-links a.apk-footer-link {
    color: #0070f3 !important;
    font-weight: 800 !important;
  }

  [data-theme='light'] .footer-links a.apk-footer-link:hover {
    color: #0056b3 !important;
    text-shadow: none !important;
  }

  [data-theme='light'] .privacy-badge {
    background: #ecfdf5 !important;
    border: 1.5px solid #a7f3d0 !important;
    color: #065f46 !important;
    font-weight: 500 !important;
  }

  [data-theme='light'] .privacy-badge strong {
    color: #047857 !important;
    font-weight: 800 !important;
  }

  [data-theme='light'] .footer-bottom {
    border-top: 1px solid #e2e8f0 !important;
  }

  [data-theme='light'] .copyright,
  [data-theme='light'] .tech-stack-tag {
    color: #64748b !important;
  }

  [data-theme='light'] .legal-mini-links a {
    color: #475569 !important;
  }

  [data-theme='light'] .legal-mini-links a:hover {
    color: #0070f3 !important;
  }
</style>
