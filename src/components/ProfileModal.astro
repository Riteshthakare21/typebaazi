</style>

<script>
  import { StorageManager } from '../lib/storage';
  import { getLevelInfo } from '../lib/gamification';
  import { streakNotifManager } from '../lib/streakNotifications';

  function updateProfileUI() {
    const modal = document.getElementById('typebaazi-profile-modal');
    if (!modal) return;

    const stats = StorageManager.getStats();
    const settings = StorageManager.getSettings();
    const levelInfo = getLevelInfo(stats.xp);

    const nameInput = document.getElementById('profile-name-input') as HTMLInputElement | null;
    const levelPill = document.getElementById('profile-level-pill');
    const titleEn = document.getElementById('profile-title-en');
    const titleMr = document.getElementById('profile-title-mr');
    const xpFill = document.getElementById('profile-xp-fill');
    const xpCurrent = document.getElementById('profile-xp-current');
    const xpNext = document.getElementById('profile-xp-next');

    const streakCount = document.getElementById('profile-streak-count');
    const longestStreak = document.getElementById('profile-longest-streak');
    const statusBox = document.getElementById('profile-streak-status-box');
    const statusIcon = document.getElementById('profile-status-icon');
    const statusHeading = document.getElementById('profile-status-heading');
    const statusDesc = document.getElementById('profile-status-desc');
    const practiceBtn = document.getElementById('profile-practice-btn');
    const weeklyGrid = document.getElementById('profile-weekly-grid');

    // Profile Identity (do not overwrite while user is actively typing)
    if (nameInput && document.activeElement !== nameInput) {
      nameInput.value = settings.userName || '';
    }

    // Avatar active state & header icon
    const currentAvatar = settings.userAvatar || '🏎️';
    const headerAvatarIcon = document.getElementById('profile-modal-avatar-icon');
    if (headerAvatarIcon) headerAvatarIcon.textContent = currentAvatar;

    modal.querySelectorAll('.avatar-opt').forEach(btn => {
      const avatar = (btn as HTMLElement).dataset.avatar;
      btn.classList.toggle('active', avatar === currentAvatar);
    });

    // Level info
    if (levelPill) levelPill.textContent = `Level ${levelInfo.level}`;
    if (titleEn) titleEn.textContent = levelInfo.title;
    if (titleMr) titleMr.textContent = levelInfo.titleMr;
    if (xpFill) xpFill.style.width = `${levelInfo.progressPercent}%`;
    if (xpCurrent) xpCurrent.textContent = `${stats.xp} XP Total`;
    if (xpNext) xpNext.textContent = `Next Level at ${levelInfo.maxXp} XP`;

    // Streak stats
    const curStreak = stats.currentStreak || 0;
    const bestStreak = stats.longestStreak || 0;
    if (streakCount) streakCount.textContent = String(curStreak);
    if (longestStreak) longestStreak.textContent = `${bestStreak} Days`;

    // Today's Status
    const today = new Date().toISOString().split('T')[0];
    const isCompletedToday = stats.lastActiveDate === today;

    if (isCompletedToday) {
      statusBox?.classList.add('is-safe');
      if (statusIcon) statusIcon.textContent = '✅';
      if (statusHeading) statusHeading.textContent = 'Streak Maintained for Today!';
      if (statusDesc) statusDesc.textContent = `Awesome work! Your daily typing streak is safe (${curStreak} days). Come back tomorrow to advance!`;
      if (practiceBtn) practiceBtn.style.display = 'none';
    } else {
      statusBox?.classList.remove('is-safe');
      if (statusIcon) statusIcon.textContent = '🔥';
      if (statusHeading) statusHeading.textContent = 'Streak At Risk Today!';
      if (statusDesc) statusDesc.textContent = 'Complete at least 1 typing test or race today to keep your flame burning.';
      if (practiceBtn) practiceBtn.style.display = 'inline-flex';
    }

    // Weekly visual grid
    if (weeklyGrid) {
      const dayNames = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
      const now = new Date();
      const currentDayIdx = (now.getDay() + 6) % 7;

      weeklyGrid.innerHTML = dayNames.map((name, i) => {
        const isToday = i === currentDayIdx;
        const isPastOrToday = i <= currentDayIdx;
        const hasPracticed = isPastOrToday && (i === currentDayIdx ? isCompletedToday : true);
        return `
          <div class="w-day-box ${isToday ? 'is-today' : ''} ${hasPracticed ? 'completed' : ''}">
            <span class="w-day-lbl">${name}</span>
            <span class="w-day-check">${hasPracticed ? '✓' : '•'}</span>
          </div>
        `;
      }).join('');
    }

    // Streak Milestones
    const milestones = [
      { days: 7, cardId: 'prof-ms-7', tagId: 'prof-tag-7', btnId: null, type: null },
      { days: 25, cardId: 'prof-ms-25', tagId: 'prof-tag-25', btnId: 'prof-btn-25', type: 'streak-25' },
      { days: 50, cardId: 'prof-ms-50', tagId: 'prof-tag-50', btnId: 'prof-btn-50', type: 'streak-50' },
      { days: 100, cardId: 'prof-ms-100', tagId: 'prof-tag-100', btnId: 'prof-btn-100', type: 'streak-100' },
      { days: 365, cardId: 'prof-ms-365', tagId: 'prof-tag-365', btnId: 'prof-btn-365', type: 'streak-365' }
    ];

    const effective = Math.max(curStreak, bestStreak);

    milestones.forEach(m => {
      const card = document.getElementById(m.cardId);
      const tag = document.getElementById(m.tagId);
      const btn = m.btnId ? document.getElementById(m.btnId) : null;

      if (effective >= m.days) {
        card?.classList.add('unlocked');
        if (tag) tag.textContent = '✓ Unlocked';
        if (btn) btn.classList.remove('hidden');
      } else {
        card?.classList.remove('unlocked');
        if (tag) tag.textContent = `${effective}/${m.days}d`;
        if (btn) btn.classList.add('hidden');
      }
    });

    // Streak Notification Setting UI
    const notifBadge = document.getElementById('notif-mode-badge');
    const notifBtnIcon = document.getElementById('streak-notif-btn-icon');
    const notifBtnLabel = document.getElementById('streak-notif-btn-label');
    const notifScheduleContainer = document.getElementById('notif-schedule-pills');

    const isApp = streakNotifManager.isAppInstalled();
    if (notifBadge) {
      notifBadge.textContent = isApp ? '📱 2x Daily (Randomized)' : '🌐 2x Daily (Randomized)';
    }

    const isEnabled = streakNotifManager.isEnabled();
    if (notifBtnIcon && notifBtnLabel) {
      if (isEnabled) {
        notifBtnIcon.textContent = '✅';
        notifBtnLabel.textContent = 'Active (Reminding)';
      } else {
        notifBtnIcon.textContent = '🔔';
        notifBtnLabel.textContent = 'Enable Reminders';
      }
    }

    if (notifScheduleContainer) {
      const schedule = streakNotifManager.getActiveSchedule();
      notifScheduleContainer.innerHTML = schedule.map(slot => `
        <span class="notif-chip">⏰ ${slot.label}</span>
      `).join('');
    }
  }

  // Document-level event delegation (works across all Astro page navigations)
  document.addEventListener('input', (e) => {
    const target = e.target as HTMLElement;
    if (target && target.id === 'profile-name-input') {
      const val = (target as HTMLInputElement).value;
      StorageManager.saveSettings({ userName: val });
    }
  });

  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (target && target.id === 'profile-name-input') {
      e.stopPropagation();
      if (e.key === 'Enter') {
        e.preventDefault();
        const saveBtn = document.getElementById('btn-save-profile');
        saveBtn?.click();
      }
    }
  });

  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    // Save Profile Button
    const saveBtn = target.closest('#btn-save-profile') as HTMLButtonElement | null;
    if (saveBtn) {
      const nameInput = document.getElementById('profile-name-input') as HTMLInputElement | null;
      const activeAvatar = document.querySelector('.avatar-opt.active') as HTMLElement | null;

      const newName = nameInput?.value.trim() || 'Speed Champion';
      const newAvatar = activeAvatar?.dataset.avatar || '🏎️';

      StorageManager.saveSettings({ userName: newName, userAvatar: newAvatar });
      window.dispatchEvent(new CustomEvent('user-name-changed', { detail: { name: newName } }));
      window.dispatchEvent(new CustomEvent('user-avatar-changed', { detail: { avatar: newAvatar } }));

      // Visual feedback
      const textEl = document.getElementById('save-profile-btn-text');
      if (textEl) textEl.textContent = '✅ Saved!';
      saveBtn.classList.add('btn-saved');

      setTimeout(() => {
        if (textEl) textEl.textContent = '💾 Save Changes';
        saveBtn.classList.remove('btn-saved');
        const modal = document.getElementById('typebaazi-profile-modal');
        modal?.classList.add('hidden');
      }, 400);
      return;
    }

    // Toggle streak notifications button
    if (target.closest('#btn-toggle-streak-notifs')) {
      const current = streakNotifManager.isEnabled();
      if (current) {
        streakNotifManager.setEnabled(false);
      } else {
        await streakNotifManager.requestPermission();
      }
      updateProfileUI();
      return;
    }

    // Avatar selection
    const avatarBtn = target.closest('.avatar-opt') as HTMLElement | null;
    if (avatarBtn) {
      const avatar = avatarBtn.dataset.avatar || '🏎️';
      document.querySelectorAll('.avatar-opt').forEach(b => b.classList.remove('active'));
      avatarBtn.classList.add('active');

      const headerAvatarIcon = document.getElementById('profile-modal-avatar-icon');
      if (headerAvatarIcon) headerAvatarIcon.textContent = avatar;

      StorageManager.saveSettings({ userAvatar: avatar });
      window.dispatchEvent(new CustomEvent('user-avatar-changed', { detail: { avatar } }));
      return;
    }

    // Certificate claim buttons
    const certBtn = target.closest('.ms-p-claim-btn') as HTMLElement | null;
    if (certBtn) {
      const certType = certBtn.dataset.cert as any;
      let days = 50;
      if (certType === 'streak-25') days = 25;
      if (certType === 'streak-100') days = 100;
      if (certType === 'streak-365') days = 365;

      const stats = StorageManager.getStats();
      const modal = document.getElementById('typebaazi-profile-modal');
      modal?.classList.add('hidden');

      window.dispatchEvent(new CustomEvent('open-certificate-modal', {
        detail: {
          type: certType,
          streakDays: days,
          wpm: Math.max(stats.english.bestWpm,stats.hindi.bestWpm, stats.marathi.bestWpm) || 75
        }
      }));
      return;
    }

    // Practice button click
    if (target.closest('#profile-practice-btn')) {
      const modal = document.getElementById('typebaazi-profile-modal');
      modal?.classList.add('hidden');
      return;
    }

    // Cancel / Close buttons
    if (target.closest('#btn-cancel-profile') || target.closest('#close-profile-btn') || target.id === 'typebaazi-profile-modal') {
      const modal = document.getElementById('typebaazi-profile-modal');
      modal?.classList.add('hidden');
      return;
    }
  });

  // Global trigger to open profile modal
  window.addEventListener('open-profile-modal', () => {
    updateProfileUI();
    const modal = document.getElementById('typebaazi-profile-modal');
    modal?.classList.remove('hidden');
    setTimeout(() => {
      const input = document.getElementById('profile-name-input') as HTMLInputElement | null;
      if (input) {
        input.focus();
      }
    }, 50);
  });

  document.addEventListener('astro:page-load', updateProfileUI);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateProfileUI);
  } else {
    updateProfileUI();
  }
</script>
