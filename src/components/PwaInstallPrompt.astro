---
/**
 * TypeBaazi Official App Install Banner
 * Sits naturally in document flow below sticky navbar, scrolling smoothly without any header overlap.
 */
---

<div id="pwa-install-banner" class="pwa-banner-wrapper hidden" role="region" aria-label="Install TypeBaazi App">
  <div class="pwa-banner-container">
    <div class="pwa-top-card">
      <!-- Close Dismiss 'X' Button -->
      <button id="pwa-btn-dismiss-x" class="pwa-close-x" type="button" title="Dismiss" aria-label="Close">✕</button>

      <div class="pwa-top-content">
        <!-- App Icon Badge matching exact official TypeBaazi website logo -->
        <div class="pwa-app-icon">
          <svg width="34" height="34" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="1.5" y="1.5" width="29" height="29" rx="8" fill="#080e1b" stroke="#00f0ff" stroke-width="1.6" />
            <g transform="translate(4, 4)">
              <path d="M13 2L3 14H12L11 22L21 10H12L13 2Z" fill="url(#pwa-bolt-grad)" stroke="#00f0ff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </g>
            <defs>
              <linearGradient id="pwa-bolt-grad" x1="3" y1="2" x2="21" y2="22" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#00f0ff"/>
                <stop offset="100%" stop-color="#ff007a"/>
              </linearGradient>
            </defs>
          </svg>
        </div>

        <div class="pwa-text-group">
          <div class="pwa-title-row">
            <h4 class="pwa-title" id="pwa-main-title">Install TypeBaazi App</h4>
            <span class="pwa-free-badge">FREE</span>
          </div>
          <p class="pwa-desc" id="pwa-main-desc">
            High-speed practice, zero lag &amp; offline mode for Android &amp; Desktop!
          </p>
        </div>

        <!-- Action Buttons -->
        <div class="pwa-actions-row">
          <button id="pwa-btn-install" class="pwa-install-btn" type="button" title="Install App">
            <span id="pwa-btn-install-text">⚡ Install App</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .pwa-banner-wrapper {
    width: 100%;
    position: relative;
    z-index: 90; /* Sits naturally in document flow, well below sticky navbar (z-index: 999995) */
    padding: 10px 16px 0;
    box-sizing: border-box;
    display: block;
    animation: pwaSlideDown 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transition: max-height 0.3s ease, opacity 0.25s ease, padding 0.3s ease, margin 0.3s ease;
    overflow: hidden;
    max-height: 140px;
  }

  .pwa-banner-wrapper.hidden {
    display: none !important;
  }

  .pwa-banner-wrapper.sliding-up {
    max-height: 0 !important;
    opacity: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    margin: 0 !important;
  }

  .pwa-banner-container {
    max-width: 680px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  @keyframes pwaSlideDown {
    0% {
      opacity: 0;
      transform: translateY(-8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .pwa-top-card {
    background: #080d1c;
    border: 1.5px solid #00f0ff;
    border-radius: 14px;
    padding: 10px 14px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.85), 0 0 18px rgba(0, 240, 255, 0.25);
    position: relative;
    box-sizing: border-box;
    width: 100%;
  }

  .pwa-close-x {
    position: absolute;
    top: 7px;
    right: 7px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #e2e8f0;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    border-radius: 6px;
    transition: all 0.15s ease;
    z-index: 2;
  }

  .pwa-close-x:hover,
  .pwa-close-x:active {
    color: #ffffff;
    background: rgba(255, 0, 122, 0.35);
    border-color: #ff007a;
  }

  .pwa-top-content {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-right: 22px;
  }

  .pwa-app-icon {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    filter: drop-shadow(0 0 8px rgba(0, 240, 255, 0.45));
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }

  .pwa-app-icon svg {
    width: 34px;
    height: 34px;
    display: block;
  }

  .pwa-text-group {
    flex: 1;
    min-width: 0;
  }

  .pwa-title-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 2px;
  }

  .pwa-title {
    font-size: 13.5px;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.2px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
  }

  .pwa-free-badge {
    background: rgba(16, 185, 129, 0.25);
    color: #34d399;
    border: 1px solid #10b981;
    font-size: 9.5px;
    font-weight: 900;
    padding: 1px 5px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }

  .pwa-desc {
    font-size: 11.5px;
    font-weight: 600;
    color: #e2e8f0;
    line-height: 1.3;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pwa-actions-row {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .pwa-install-btn {
    background: linear-gradient(135deg, #00f0ff 0%, #00b4d8 100%);
    color: #030712;
    border: none;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 900;
    border-radius: 8px;
    white-space: nowrap;
    cursor: pointer;
    box-shadow: 0 0 14px rgba(0, 240, 255, 0.45);
    transition: all 0.2s ease;
  }

  .pwa-install-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.7);
    filter: brightness(1.1);
  }

  [data-theme='light'] .pwa-top-card {
    background: #ffffff !important;
    border: 1.5px solid #0070f3 !important;
    box-shadow: 0 4px 18px rgba(0, 112, 243, 0.12), 0 2px 6px rgba(15, 23, 42, 0.05) !important;
  }

  [data-theme='light'] .pwa-title {
    color: #0f172a !important;
    text-shadow: none !important;
  }

  [data-theme='light'] .pwa-desc {
    color: #334155 !important;
    text-shadow: none !important;
  }

  @media (max-width: 600px) {
    .pwa-banner-wrapper {
      padding: 8px 10px 0;
    }

    .pwa-top-card {
      padding: 8px 10px;
      border-radius: 12px;
    }

    .pwa-app-icon {
      width: 30px;
      height: 30px;
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
    }

    .pwa-app-icon svg {
      width: 30px;
      height: 30px;
    }

    .pwa-title {
      font-size: 12.5px;
    }

    .pwa-free-badge {
      font-size: 8.5px;
      padding: 0.5px 4px;
    }

    .pwa-desc {
      font-size: 10.5px;
    }

    .pwa-install-btn {
      padding: 6px 11px;
      font-size: 11px;
      border-radius: 7px;
    }

    .pwa-close-x {
      top: 6px;
      right: 6px;
      font-size: 12px;
      width: 22px;
      height: 22px;
    }
  }
</style>

<script>
  let deferredPrompt: any = null;
  const banner = document.getElementById('pwa-install-banner');
  const btnInstall = document.getElementById('pwa-btn-install');
  const btnInstallText = document.getElementById('pwa-btn-install-text');
  const btnCloseX = document.getElementById('pwa-btn-dismiss-x');

  function isRunningStandalone(): boolean {
    try {
      const isStandaloneWindow = window.matchMedia('(display-mode: standalone)').matches;
      const isIOSStandalone = (window.navigator as any).standalone === true;
      return isStandaloneWindow || isIOSStandalone;
    } catch {
      return false;
    }
  }

  function isAndroid(): boolean {
    return /Android/i.test(navigator.userAgent);
  }

  function isIOS(): boolean {
    return (
      /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (navigator.maxTouchPoints > 1 && /Macintosh/.test(navigator.userAgent))
    );
  }

  function hideBanner() {
    if (banner) {
      banner.classList.add('sliding-up');
      setTimeout(() => {
        banner.classList.add('hidden');
        banner.classList.remove('sliding-up');
        window.dispatchEvent(new CustomEvent('typebaazi-install-banner-closed'));
      }, 350);
    }
  }

  function showBanner() {
    if (isRunningStandalone()) return;
    if (banner) {
      banner.classList.remove('hidden');
    }
  }

  // Global hook for navbar/mobile buttons
  (window as any).showTypeBaaziInstallPrompt = function() {
    showBanner();
  };

  function triggerApkDownload() {
    try {
      const link = document.createElement('a');
      link.href = '/typebaazi.apk';
      link.download = 'typebaazi.apk';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    } catch (e) {
      window.location.href = '/typebaazi.apk';
    }
  }

  // 1. Capture beforeinstallprompt event
  window.addEventListener('beforeinstallprompt', (event: Event) => {
    event.preventDefault();
    deferredPrompt = event;
    showBanner();
  });

  // 2. Automatically show at top in normal flow after 400ms on website open
  setTimeout(() => {
    showBanner();
  }, 400);

  // 3. Action button click
  btnInstall?.addEventListener('click', async () => {
    if (isAndroid()) {
      if (btnInstallText) btnInstallText.textContent = '⬇️ Downloading APK...';
      triggerApkDownload();

      if (deferredPrompt) {
        try {
          await deferredPrompt.prompt();
        } catch {}
      }

      setTimeout(() => {
        if (btnInstallText) btnInstallText.textContent = '✓ Downloaded!';
        setTimeout(() => hideBanner(), 2500);
      }, 1500);
      return;
    }

    if (deferredPrompt) {
      try {
        await deferredPrompt.prompt();
        const choiceResult = await deferredPrompt.userChoice;
        if (choiceResult && choiceResult.outcome === 'accepted') {
          hideBanner();
        }
      } catch (err) {
        console.warn('Install prompt error:', err);
      }
      deferredPrompt = null;
      return;
    }

    if (isIOS()) {
      if (btnInstallText) btnInstallText.textContent = '📲 Tap Share ⎋ → Add to Home Screen';
      setTimeout(() => hideBanner(), 4000);
      return;
    }

    // Desktop fallback: Download APK package
    if (btnInstallText) btnInstallText.textContent = '⬇️ Downloading...';
    triggerApkDownload();
    setTimeout(() => {
      if (btnInstallText) btnInstallText.textContent = '✓ Downloaded!';
      setTimeout(() => hideBanner(), 2000);
    }, 1200);
  });

  btnCloseX?.addEventListener('click', hideBanner);

  window.addEventListener('appinstalled', () => {
    hideBanner();
    deferredPrompt = null;
  });
</script>
