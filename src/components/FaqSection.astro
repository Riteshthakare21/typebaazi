---
// FaqSection.astro - Core Essential SEO FAQ Component (4 Key Questions) with Schema.org JSON-LD
interface Props {
  showSchema?: boolean;
}

const { showSchema = true } = Astro.props;

const faqItems = [
  {
    icon: '🌐',
    q: 'Which languages are available for typing on TypeBaazi?',
    a: 'TypeBaazi officially supports <strong>English, Hindi (हिंदी), and Marathi (मराठी)</strong>. You can take timed speed tests (60s and 180s), 7-minute government exam simulations, race AI cars, and practice with real-time Devanagari virtual keyboards across all three languages.'
  },
  {
    icon: '⚡',
    q: 'What is the average and good typing speed?',
    a: 'The global average typing speed for most adults is approximately <strong>40 Words Per Minute (WPM)</strong> with an accuracy rate of 92%. A speed of <strong>50 to 70 WPM</strong> is considered "good" and ideal for professional and technical productivity. Speeds between <strong>70 and 90 WPM</strong> are very fast, while <strong>100+ WPM</strong> places you in the top 1% of elite typists worldwide. For government exams like Maharashtra GCC-TBC, speed benchmarks are set at <strong>30 WPM, 40 WPM, and 50 WPM</strong>.'
  },
  {
    icon: '🚀',
    q: 'How to get better and learn typing fast in English?',
    a: `To rapidly increase your <strong>english typing</strong> speed and master touch typing:
      <ul>
        <li><strong>Master the Home Row:</strong> Anchor your index fingers on the <code>F</code> and <code>J</code> tactile bumps, resting fingers on <code>A-S-D-F</code> and <code>J-K-L-;</code>.</li>
        <li><strong>Never Look at the Keys:</strong> Train your brain to rely purely on spatial muscle memory.</li>
        <li><strong>Prioritize 98%+ Accuracy:</strong> Fixing typos with Backspace takes 3x more time than typing steadily.</li>
        <li><strong>Practice 15 Minutes Daily:</strong> Play interactive <strong>car racing typing games</strong> on TypeBaazi to condition fast reflexes under fun pressure.</li>
      </ul>`
  },
  {
    icon: '🇮🇳',
    q: 'How to do Marathi typing (मराठी टायपिंग) and type conjuncts (जोडाक्षरे)?',
    a: `To practice <strong>marathi type</strong> (मराठी टायपिंग सराव) on TypeBaazi:
      <ol>
        <li><strong>Enable Inscript Keyboard:</strong> Add the standard Marathi Inscript keyboard in Windows or Android language settings (vowels on the left hand, consonants on the right).</li>
        <li><strong>Form Conjuncts with Halant (्):</strong> Use key <code>d</code> (halant). For example, <strong>क्ष</strong> = <code>k</code> (क) + <code>d</code> (्) + <code>Shift+&lt;</code> (ष), and <strong>त्र</strong> = <code>l</code> (त) + <code>d</code> (्) + <code>j</code> (र).</li>
        <li><strong>GCC-TBC Practice:</strong> Train with authentic government syllabus passages on TypeBaazi's <a href="/marathi-typing-test" style="color: var(--accent-cyan); text-decoration: underline;">Marathi Arena</a> with live key visualizers.</li>
      </ol>`
  },
  {
    icon: '🇮🇳',
    q: 'How to do Hindi typing (हिंदी टाइपिंग) and type Matras (मात्राएँ)?',
    a: `Hindi typing can be learned by practicing the Hindi keyboard layout or using phonetic/Google IME typing. Start with common Hindi letters and words, then practice matras such as <strong>ा, ि, ी, ु, ू, े, ै, ो, ौ</strong> and common conjunct letters. Focus on accuracy first and gradually increase typing speed with regular practice on TypeBaazi's <a href="/hindi-typing-test" style="color: var(--accent-cyan); text-decoration: underline;">Hindi Typing Arena</a>.`
  },
  {
    icon: '🛠️',
    q: 'How to fix keyboard not typing or lagging?',
    a: `If your physical keyboard stops typing or experiences input lag:
      <ol>
        <li><strong>Re-plug Connection:</strong> Reconnect the USB cable into a different port or toggle Bluetooth off/on.</li>
        <li><strong>Restart Your PC:</strong> Clears temporary driver locks and OS buffer delays.</li>
        <li><strong>Disable Windows Filter Keys:</strong> Press the right <code>Shift</code> key for 8 seconds or go to <em>Settings &gt; Accessibility &gt; Keyboard</em> and switch off <em>Filter Keys</em> and <em>Sticky Keys</em>.</li>
        <li><strong>Test Hardware with TypeBaazi:</strong> Open our on-screen <a href="/typing-test" style="color: var(--accent-cyan); text-decoration: underline;">Virtual Keyboard</a> to check if individual switches are registering cleanly.</li>
      </ol>`
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q.replace(/<[^>]*>?/gm, ''),
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a.replace(/<[^>]*>?/gm, ' ').replace(/\s+/g, ' ').trim()
    }
  }))
};
---

<section class="faq-master-section" id="faq-section">
  <div class="faq-header-bar">
    <span class="badge badge-cyan">💡 Knowledge Base &amp; FAQ</span>
    <h2 class="faq-main-heading">Frequently Asked Questions (FAQ)</h2>
    <p class="faq-main-sub">
      Expert answers to common questions about typing speed, touch typing techniques, Hindi &amp; Marathi Inscript keyboards, and troubleshooting.
    </p>
  </div>

  <div class="faq-accordion-container">
    {faqItems.map((item) => (
      <details class="faq-accordion-item">
        <summary class="faq-question">
          <span class="faq-q-text">{item.icon} {item.q}</span>
          <span class="faq-chevron">▾</span>
        </summary>
        <div class="faq-answer">
          <div set:html={item.a} />
        </div>
      </details>
    ))}
  </div>
</section>

{showSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
)}

<style is:global>
  .faq-master-section {
    padding: clamp(24px, 4vw, 40px);
    box-sizing: border-box;
    width: 100%;
    border: 1.5px solid rgba(0, 240, 255, 0.25);
    border-radius: var(--radius-xl, 22px);
    background: linear-gradient(180deg, rgba(12, 18, 34, 0.95) 0%, rgba(8, 12, 22, 0.98) 100%);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
    margin: 36px 0;
  }

  .faq-header-bar {
    margin-bottom: 24px;
    text-align: left;
  }

  .faq-main-heading {
    font-size: clamp(22px, 4vw, 30px);
    font-weight: 900;
    color: #ffffff;
    margin: 10px 0 6px;
    line-height: 1.25;
  }

  .faq-main-sub {
    font-size: clamp(13px, 2vw, 15px);
    color: var(--text-muted, #94a3b8);
    margin: 0;
    line-height: 1.5;
  }

  .faq-accordion-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    box-sizing: border-box;
  }

  .faq-accordion-item {
    background: rgba(14, 20, 36, 0.75);
    border: 1.5px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md, 12px);
    transition: all 0.2s ease;
    overflow: hidden;
    box-sizing: border-box;
  }

  .faq-accordion-item[open] {
    border-color: rgba(0, 240, 255, 0.45);
    background: rgba(16, 26, 48, 0.9);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    font-size: clamp(14px, 2.2vw, 16px);
    font-weight: 800;
    color: #ffffff;
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-q-text {
    flex: 1;
    min-width: 0;
    line-height: 1.35;
  }

  .faq-chevron {
    font-size: 16px;
    color: var(--accent-cyan, #00f0ff);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .faq-accordion-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 20px 18px;
    font-size: clamp(13px, 1.9vw, 14.5px);
    color: var(--text-muted, #94a3b8);
    line-height: 1.65;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: 4px;
    padding-top: 14px;
  }

  .faq-answer p {
    margin: 0 0 10px;
  }

  .faq-answer p:last-child {
    margin-bottom: 0;
  }

  .faq-answer ul,
  .faq-answer ol {
    margin: 8px 0 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .faq-answer li {
    line-height: 1.55;
  }

  .faq-answer code {
    background: rgba(0, 240, 255, 0.1);
    color: var(--accent-cyan, #00f0ff);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 12.5px;
  }

  /* Light Theme */
  [data-theme='light'] .faq-master-section {
    background: #ffffff !important;
    border: 1.5px solid #e2e8f0 !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05) !important;
  }

  [data-theme='light'] .faq-main-heading {
    color: #0f172a !important;
  }

  [data-theme='light'] .faq-main-sub {
    color: #64748b !important;
  }

  [data-theme='light'] .faq-accordion-item {
    background: #f8fafc !important;
    border: 1.5px solid #e2e8f0 !important;
  }

  [data-theme='light'] .faq-accordion-item[open] {
    background: #ffffff !important;
    border-color: #0070f3 !important;
    box-shadow: 0 4px 16px rgba(0, 112, 243, 0.08) !important;
  }

  [data-theme='light'] .faq-question {
    color: #0f172a !important;
  }

  [data-theme='light'] .faq-chevron {
    color: #0070f3 !important;
  }

  [data-theme='light'] .faq-answer {
    color: #334155 !important;
    border-top-color: #e2e8f0 !important;
  }

  [data-theme='light'] .faq-answer code {
    background: #f1f5f9 !important;
    color: #004bbb !important;
    border: 1px solid #cbd5e1 !important;
  }

  @media (max-width: 480px) {
    .faq-master-section {
      padding: 18px 14px;
    }
    .faq-question {
      padding: 12px 14px;
      font-size: 13.5px;
    }
    .faq-answer {
      padding: 0 14px 14px;
      font-size: 12.5px;
    }
  }
</style>
