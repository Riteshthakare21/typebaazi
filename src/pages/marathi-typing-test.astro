    color: var(--text-muted, #94a3b8);
    max-width: 780px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .header-cta-row {
    margin-top: 16px;
  }

  .start-typing-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
    border-radius: 12px;
  }

  .arena-section {
    margin-bottom: 36px;
  }

  .marathi-info-panel,
  .faq-panel {
