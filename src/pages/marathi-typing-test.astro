    padding: clamp(14px, 2.5vw, 28px) clamp(10px, 2vw, 20px) 60px;
    max-width: 1100px;
    margin: 0 auto;
    box-sizing: border-box;
    width: 100%;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted, #94a3b8);
    margin-bottom: 16px;
  }

  .breadcrumb-nav a {
    color: var(--accent-cyan, #00f0ff);
    text-decoration: none;
  }

  .bc-sep {
