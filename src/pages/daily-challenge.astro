---
import Layout from '../layouts/Layout.astro';
import TypingArena from '../components/TypingArena.astro';
import VirtualKeyboard from '../components/VirtualKeyboard.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://typebaazi.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Daily Typing Challenge",
      "item": "https://typebaazi.com/daily-challenge"
    }
  ]
};

const dailyChallengeFaqs = [
  {
    question: "What is the TypeBaazi Daily Typing Challenge?",
    answer: "The Daily Typing Challenge is a synchronized, deterministic daily typing test. Every calendar day (starting at 00:00 UTC), a new curated passage is generated across English, Hindi, and Marathi. Completing the target speed and accuracy awards +100 bonus XP and increments your daily practice streak."
  },
  {
    question: "Does everyone get the same daily passage?",
    answer: "Yes! Using an algorithmic pseudo-random date seed, all typists across the world type the identical passage on any given day. This creates fair, transparent daily leaderboard competition."
  },
  {
    question: "What happens if I miss a day in my streak?",
    answer: "Typing streaks require at least one successfully completed 60-second test within 24 hours. If a day passes without practice, the streak resets to zero unless a Streak Freeze protection has been unlocked."
  },
  {
    question: "Why is daily 1-minute typing practice recommended by cognitive scientists?",
    answer: "Motor skill consolidation relies heavily on neuro-muscular myelination. Studies show that 1 to 5 minutes of focused daily touch typing practice yields 3x faster speed retention compared to practicing for 2 hours once a week."
  },
  {
    question: "Can I complete the Daily Challenge in Hindi or Marathi?",
    answer: "Yes! You can choose between English, Hindi Devanagari, or Marathi Devanagari using the language toggle in the toolbar before starting today's sprint."
  }
];
---

<Layout
  title="Daily Typing Challenge & Streak — English, Hindi & Marathi | TypeBaazi"
  description="Take on today's official Daily Typing Challenge. Maintain your consecutive day typing streak in English, Hindi, and Marathi, earn +100 bonus XP, and unlock streak badges on TypeBaazi."
  activePath="/daily-challenge"
  faqItems={dailyChallengeFaqs}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="container page-container">
    <div class="page-header">
      <div class="badge badge-gold">🔥 Daily Challenge Sprint</div>
      <h1 class="page-title">Today's Official Typing Challenge</h1>
      <p class="page-sub">
        Every calendar day brings a new deterministic typing sprint. Complete today's target to fuel your daily streak!
      </p>
    </div>

    <!-- Daily Challenge Summary Card -->
    <div class="daily-hero-card glass-panel">
      <div class="daily-hero-left">
        <div class="flame-badge-big">🔥</div>
        <div>
          <span class="daily-date-tag" id="dc-date-tag">Today's Mission</span>
          <h2 class="daily-target-title">Target: <span id="dc-target-wpm" class="text-cyan">55 WPM</span> (95% Accuracy)</h2>
          <p class="daily-bonus-txt">Reward: <strong>+100 Bonus XP</strong> &amp; Streak Increment</p>
        </div>
      </div>

      <div class="streak-counter-box">
        <span class="streak-huge-num" id="dc-streak-num">0</span>
        <span class="streak-lbl">DAY STREAK</span>
      </div>
    </div>

    <!-- Arena with preloaded Daily Challenge Text -->
    <TypingArena initialLanguage="english" initialDuration={60} initialDifficulty="medium" mode="daily" showControls={true} />

    <!-- Virtual Keyboard -->
    <VirtualKeyboard language="english" visible={true} />

    <!-- Streak Guide & Comprehensive Educational Handbook -->
    <article class="daily-guide-card glass-panel" itemscope itemtype="https://schema.org/Article" style="margin-top: 28px; padding: 26px; border-radius: 16px; background: rgba(14, 21, 37, 0.85); border: 1.5px solid rgba(245, 158, 11, 0.25);">
      <header class="guide-article-header" style="border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 16px; margin-bottom: 20px;">
        <span class="badge badge-gold">🔥 Habit Psychology &amp; Neuroplasticity</span>
        <h2 itemprop="headline" style="font-size: 22px; font-weight: 900; color: #ffffff; margin: 8px 0 10px;">
          The Neuroscience of Daily Typing Practice: Why Streaks Build World-Class Speed
        </h2>
        <p style="font-size: 14.5px; color: var(--text-muted, #94a3b8); line-height: 1.6; margin: 0;">
          Typing at 80+ Words Per Minute is fundamentally not about finger muscle strength — it is about the speed and density of <strong>myelin sheaths</strong> coating the neural motor pathways connecting your visual cortex to your finger digits. Maintaining a daily unbroken practice streak is the scientifically proven catalyst for lifelong muscle memory.
        </p>
      </header>

      <section class="guide-content-block" style="margin: 20px 0;">
        <h3 style="font-size: 17px; font-weight: 800; color: #f59e0b; margin-bottom: 8px;">1. The Spaced Repetition Advantage Over Marathon Weekend Sessions</h3>
        <p style="font-size: 14px; color: var(--text-muted, #94a3b8); line-height: 1.7;">
          According to the <em>Ebbinghaus Forgetting Curve</em>, the human brain discards up to 70% of newly acquired motor patterns within 24 to 48 hours unless reactivated through spaced retrieval. Practicing for just 1 to 3 minutes every single calendar day signals to your subconscious brain that keyboard coordination is an essential survival skill. Typists who maintain a <strong>30-day streak on TypeBaazi</strong> show an average speed increase of <strong>+18.4 WPM</strong>, compared to only +3.2 WPM for irregular typists practicing equal cumulative hours.
        </p>
      </section>

      <section class="guide-content-block" style="margin: 20px 0;">
        <h3 style="font-size: 17px; font-weight: 800; color: #f59e0b; margin-bottom: 8px;">2. How the TypeBaazi Daily Challenge Works</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin: 14px 0;">
          <div style="background: rgba(8, 14, 27, 0.8); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px;">
            <span style="font-size: 22px;">🌐</span>
            <h4 style="font-size: 14px; font-weight: 800; color: #ffffff; margin: 6px 0 4px;">Universal Daily Seed</h4>
            <p style="font-size: 12.5px; color: var(--text-muted); margin: 0; line-height: 1.5;">Every typist on Earth receives the identical curated passage each day, ensuring authentic global leaderboard competition.</p>
          </div>

          <div style="background: rgba(8, 14, 27, 0.8); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px;">
            <span style="font-size: 22px;">⚡</span>
            <h4 style="font-size: 14px; font-weight: 800; color: #ffffff; margin: 6px 0 4px;">+100 Bonus XP &amp; Badges</h4>
            <p style="font-size: 12.5px; color: var(--text-muted); margin: 0; line-height: 1.5;">Completing today's mission grants substantial level-up experience points and unlocks exclusive milestone profile badges.</p>
          </div>

          <div style="background: rgba(8, 14, 27, 0.8); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px;">
            <span style="font-size: 22px;">🛡️</span>
            <h4 style="font-size: 14px; font-weight: 800; color: #ffffff; margin: 6px 0 4px;">Anti-Loss Notifications</h4>
            <p style="font-size: 12.5px; color: var(--text-muted); margin: 0; line-height: 1.5;">Opt-in local browser notifications gently remind you before midnight UTC so you never lose your hard-earned streak.</p>
          </div>
        </div>
      </section>

      <!-- Related Educational Guides Hub Links -->
      <section class="guide-content-block" style="margin-top: 24px; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 18px;">
        <h3 style="font-size: 16px; font-weight: 800; color: #ffffff; margin-bottom: 12px;">📚 Complement Your Daily Habit with Expert Guides</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px; margin-bottom: 20px;">
          <a href="/guides/touch-typing-rules-ergonomics/" class="btn-secondary" style="font-size: 13px; padding: 10px 14px; justify-content: flex-start; text-align: left;">
            <span>🖐️ Touch Typing Rules &amp; Posture Ergonomics</span>
          </a>
          <a href="/guides/wpm-accuracy-calculation/" class="btn-secondary" style="font-size: 13px; padding: 10px 14px; justify-content: flex-start; text-align: left;">
            <span>📊 How WPM &amp; Net Accuracy Are Calculated</span>
          </a>
          <a href="/guides/marathi-inscript-keyboard-guide/" class="btn-secondary" style="font-size: 13px; padding: 10px 14px; justify-content: flex-start; text-align: left;">
            <span>⌨️ Marathi Devanagari Inscript Keyboard Guide</span>
          </a>
          <a href="/guides/gcc-tbc-exam-guide/" class="btn-secondary" style="font-size: 13px; padding: 10px 14px; justify-content: flex-start; text-align: left;">
            <span>📝 GCC-TBC Maharashtra Examination Guide</span>
          </a>
        </div>
      </section>

      <div class="daily-rel-grid" style="display: flex; flex-wrap: wrap; gap: 10px; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 16px;">
        <a href="/typing-test/" class="btn-secondary" data-analytics-cta="daily_rel_typing_test" style="font-size: 13px; padding: 8px 16px;">
          <span>⌨️ Standard Typing Speed Test</span>
        </a>
        <a href="/race/" class="btn-secondary" data-analytics-cta="daily_rel_race" style="font-size: 13px; padding: 8px 16px;">
          <span>🏎️ Grand Prix AI Car Race</span>
        </a>
        <a href="/seven-minute-typing-test/" class="btn-secondary" data-analytics-cta="daily_rel_7min" style="font-size: 13px; padding: 8px 16px;">
          <span>⏱️ 7-Minute GCC-TBC Exam Test</span>
        </a>
        <a href="/dashboard/" class="btn-secondary" data-analytics-cta="daily_rel_dashboard" style="font-size: 13px; padding: 8px 16px;">
          <span>📊 View Your Stats &amp; Badges</span>
        </a>
      </div>
    </article>
  </div>
</Layout>

<style>
  .page-container {
    padding: clamp(20px, 3vh, 40px) clamp(12px, 2vw, 20px) 60px;
    max-width: 1040px;
    margin: 0 auto;
  }

  .page-header {
    text-align: center;
    margin-bottom: 20px;
  }

  .page-title {
    font-size: clamp(26px, 6vw, 36px);
    font-weight: 900;
    color: #ffffff;
    margin: 8px 0;
    line-height: 1.2;
  }

  .page-sub {
    font-size: clamp(13px, 1.6vw, 16px);
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .daily-hero-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: clamp(16px, 2.5vw, 24px) clamp(16px, 3vw, 32px);
    margin-bottom: 20px;
    background: linear-gradient(135deg, rgba(18, 27, 46, 0.95), rgba(245, 158, 11, 0.12));
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: var(--radius-lg);
    gap: 16px;
    flex-wrap: wrap;
  }

  .daily-hero-left {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 20px);
  }

  .flame-badge-big {
    font-size: clamp(36px, 6vw, 48px);
    flex-shrink: 0;
  }

  .daily-date-tag {
    font-size: 11px;
    font-weight: 700;
    color: var(--accent-gold);
    text-transform: uppercase;
    letter-spacing: 0.6px;
  }

  .daily-target-title {
    font-size: clamp(18px, 3.5vw, 22px);
    font-weight: 800;
    color: #ffffff;
    margin: 4px 0;
  }

  .daily-bonus-txt {
    font-size: clamp(12px, 1.5vw, 13px);
    color: var(--text-muted);
  }

  .streak-counter-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 18px;
    border-radius: var(--radius-md);
    background: rgba(8, 12, 20, 0.7);
    border: 1px solid rgba(245, 158, 11, 0.4);
    min-width: 90px;
  }

  .streak-huge-num {
    font-size: clamp(28px, 5vw, 36px);
    font-weight: 900;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    line-height: 1;
  }

  .streak-lbl {
    font-size: 10px;
    font-weight: 800;
    color: var(--text-muted);
    letter-spacing: 0.8px;
    margin-top: 4px;
  }

  @media (max-width: 640px) {
    .daily-hero-card {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 14px 12px;
    }
    .daily-hero-left {
      width: 100%;
      gap: 10px;
    }
    .streak-counter-box {
      width: 100%;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 8px 14px;
    }
    .streak-lbl {
      margin-top: 0;
    }
  }

  [data-theme='light'] .daily-guide-card {
    background: #ffffff !important;
    border: 1.5px solid #e2e8f0 !important;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05) !important;
  }

  [data-theme='light'] .daily-guide-card h3 {
    color: #0f172a !important;
  }

  [data-theme='light'] .daily-guide-card p {
    color: #475569 !important;
  }
</style>

<script>
  import { DailyChallengeManager } from '../lib/dailyChallenge';
  import { StorageManager } from '../lib/storage';

  function initDailyPage() {
    const challenge = DailyChallengeManager.getTodaysChallenge();
    const stats = StorageManager.getStats();

    const dateTag = document.getElementById('dc-date-tag');
    const targetWpm = document.getElementById('dc-target-wpm');
    const streakNum = document.getElementById('dc-streak-num');

    if (dateTag) {
      dateTag.textContent = `Challenge for ${new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}`;
    }
    if (targetWpm) {
      targetWpm.textContent = `${challenge.englishChallenge.targetWpm} WPM`;
    }
    if (streakNum) {
      streakNum.textContent = String(stats.currentStreak || 0);
    }
  }

  document.addEventListener('astro:page-load', initDailyPage);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDailyPage);
  } else {
    initDailyPage();
  }
</script>
