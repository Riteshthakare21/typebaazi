---
import Layout from '../layouts/Layout.astro';
import WeeklyChampionship from '../components/WeeklyChampionship.astro';
import LeaderboardWidget from '../components/LeaderboardWidget.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://typebaazi.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Leaderboard & Championship",
      "item": "https://typebaazi.com/leaderboard"
    }
  ]
};
---

<Layout
  title="TypeBaazi Weekly Championship & Leaderboard | Global Typing Speed Rankings"
  description="Compete in the TypeBaazi Weekly Championship. Track top typists, race winners, and daily streak leaders in English, Hindi, and Marathi typing."
  activePath="/leaderboard"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="container page-container">
    <div class="page-header">
      <div class="badge badge-gold">🏆 Rankings &amp; Weekly Championship</div>
      <h1 class="page-title">TypeBaazi Global Leaderboards</h1>
      <p class="page-sub">
        Explore top scores across English WPM, Hindi WPM, Marathi WPM, AI Race victories, and continuous daily practice streaks.
      </p>

      <!-- Hub Nav Tabs -->
      <div class="hub-nav-tabs">
        <a href="/leaderboard" class="hub-tab active">
          <span>🏆 Global Rankings &amp; Championship</span>
        </a>
        <a href="/dashboard" class="hub-tab">
          <span>📊 My Stats &amp; Dashboard</span>
        </a>
      </div>
    </div>

    <!-- Weekly Championship Component -->
    <WeeklyChampionship />

    <!-- Leaderboard Widget Component -->
    <LeaderboardWidget />

    <!-- Related Challenges & Practice Modes -->
    <div class="lb-related-modes glass-panel" style="margin-top: 32px; padding: 22px; border-radius: 16px; background: rgba(14, 21, 37, 0.8); border: 1px solid rgba(255, 255, 255, 0.1);">
      <h3 style="font-size: 16px; font-weight: 800; color: #ffffff; margin-bottom: 12px;">⚡ Ready to Climb Ranks? Start Practicing Now</h3>
      <div style="display: flex; flex-wrap: wrap; gap: 10px;">
        <a href="/typing-test" class="btn-secondary" data-analytics-cta="lb_rel_typing_test" style="font-size: 13px; padding: 8px 16px;">
          <span>⌨️ Take a Speed Test</span>
        </a>
        <a href="/race" class="btn-secondary" data-analytics-cta="lb_rel_race" style="font-size: 13px; padding: 8px 16px;">
          <span>🏎️ Grand Prix AI Race</span>
        </a>
        <a href="/daily-challenge" class="btn-secondary" data-analytics-cta="lb_rel_daily" style="font-size: 13px; padding: 8px 16px;">
          <span>🔥 Daily Streak Challenge</span>
        </a>
        <a href="/seven-minute-typing-test" class="btn-secondary" data-analytics-cta="lb_rel_7min" style="font-size: 13px; padding: 8px 16px;">
          <span>⏱️ 7-Minute GCC-TBC Exam</span>
        </a>
        <a href="/games" class="btn-secondary" data-analytics-cta="lb_rel_games" style="font-size: 13px; padding: 8px 16px;">
          <span>🎮 Falling Words Game</span>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-container {
    padding: clamp(16px, 3vw, 36px) clamp(8px, 2vw, 20px) 60px;
    max-width: 1080px;
    margin: 0 auto;
    box-sizing: border-box;
    width: 100%;
  }

  .page-header {
    text-align: center;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .page-title {
    font-size: clamp(22px, 4.5vw, 36px);
    font-weight: 900;
    color: #ffffff;
    margin: 6px 0;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .page-sub {
    font-size: clamp(12.5px, 1.6vw, 15px);
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto 18px;
  }

  .hub-nav-tabs {
    display: inline-flex;
    align-items: center;
    background: rgba(18, 27, 46, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-pill);
    padding: 5px;
    gap: 6px;
    margin-top: 6px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .hub-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 20px;
    border-radius: var(--radius-pill);
    font-size: 14px;
    font-weight: 700;
    color: #e2e8f0;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .hub-tab:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
  }

  .hub-tab.active {
    background: linear-gradient(135deg, #0070f3, #7928ca);
    color: #ffffff;
    font-weight: 800;
    box-shadow: 0 2px 12px rgba(0, 112, 243, 0.4);
  }

  @media (max-width: 600px) {
    .hub-nav-tabs {
      width: 100%;
      flex-direction: column;
      border-radius: var(--radius-md);
      padding: 4px;
    }
    .hub-tab {
      width: 100%;
      justify-content: center;
      border-radius: var(--radius-sm);
      padding: 10px 14px;
      font-size: 13px;
    }
  }

  /* Explicit Light Theme Overrides */
  [data-theme='light'] .hub-nav-tabs {
    background: #e2e8f0 !important;
    border: 1px solid #cbd5e1 !important;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.06), 0 2px 8px rgba(0, 0, 0, 0.04) !important;
  }

  [data-theme='light'] .hub-tab {
    color: #1e293b !important;
    font-weight: 700 !important;
  }

  [data-theme='light'] .hub-tab:hover {
    color: #0f172a !important;
    background: rgba(255, 255, 255, 0.7) !important;
  }

  [data-theme='light'] .hub-tab.active {
    background: linear-gradient(135deg, #0070f3, #7928ca) !important;
    color: #ffffff !important;
    font-weight: 800 !important;
    box-shadow: 0 2px 10px rgba(0, 112, 243, 0.3) !important;
  }

  [data-theme='light'] .page-title {
    color: #0f172a !important;
  }

  [data-theme='light'] .page-sub {
    color: #475569 !important;
  }

  [data-theme='light'] .lb-related-modes {
    background: #ffffff !important;
    border: 1.5px solid #e2e8f0 !important;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05) !important;
  }

  [data-theme='light'] .lb-related-modes h3 {
    color: #0f172a !important;
  }
</style>
