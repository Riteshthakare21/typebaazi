---
import Layout from '../layouts/Layout.astro';
import TypingArena from '../components/TypingArena.astro';
import VirtualKeyboard from '../components/VirtualKeyboard.astro';

const pageTitle = "Hindi Typing Test Online (हिंदी टाइपिंग टेस्ट) — InScript & Remington | TypeBaazi";
const pageDesc = "Free online Hindi typing speed test and practice (हिंदी टाइपिंग टेस्ट). Measure WPM, accuracy & errors with InScript and Remington layouts for SSC, CPCT & Govt exams.";
const pageKeywords = "hindi typing test online, hindi typing practice, hindi typing speed test, hindi typing test, hindi typing online, devanagari typing test, hindi typing practice online, hindi typing speed, Hindi typing exam, Hindi typing test free, हिंदी टाइपिंग टेस्ट, हिंदी टाइपिंग सराव";

const hindiFaqs = [
  {
    question: "What is a Hindi typing test and how is typing speed calculated?",
    answer: "A Hindi typing test evaluates typing fluency in Devanagari script. In official government tests, 5 keystrokes (including consonants, vowels, matras, halants, and spaces) equal one standardized word. Gross WPM measures your raw keystroke speed, while Net WPM deducts error penalties for missed or incorrect words."
  },
  {
    question: "What is the speed requirement for SSC CGL, CHSL, and CPCT Hindi typing?",
    answer: "For SSC CHSL and CGL DEST, the standard requirement for Hindi is 30 WPM (which equals 9,000 Key Depressions Per Hour or 1,500 key depressions in 10 minutes) with up to 5% or 7% permissible error cap depending on reservation category. In MP CPCT, 20 WPM is minimum qualifying, but 30+ WPM secures a higher score band."
  },
  {
    question: "What is the difference between InScript and Remington Gail / CBI keyboard layouts?",
    answer: "InScript is the official Indian national Devanagari keyboard standard standardized by the Government of India and pre-installed in all modern operating systems. Remington Gail mimics traditional mechanical typewriters. Most modern government bodies (SSC, UPSC, High Courts, Railways) now prioritize or mandatorily test on InScript. TypeBaazi's interactive visual keyboard provides real-time InScript key highlighting."
  },
  {
    question: "How do I type conjuncts (संयुक्ताक्षर) like क्ष, त्र, ज्ञ, and श्र in Hindi InScript?",
    answer: "In InScript, type the first consonant, followed by the Halant (् / 'd' key), followed by the second consonant. For example: क + ् + ष = क्ष (k + d + Shift+,); त + ् + र = त्र (l + d + j); ज + ् + ञ = ज्ञ (p + d + Shift+&#125;); श + ् + र = श्र (Shift+m + d + j)."
  },
  {
    question: "What is Key Depressions Per Hour (KDPH) and how does it convert to WPM?",
    answer: "KDPH measures total key depressions in an hour. To convert KDPH to WPM: Divide KDPH by 5 (characters per word) and then divide by 60 (minutes per hour). For example: 9,000 KDPH / 5 = 1,800 words / 60 = 30 WPM. 10,500 KDPH = 35 WPM."
  },
  {
    question: "How are mistakes classified in SSC and Court Hindi typing tests?",
    answer: "Examinations standardly categorize errors into Full Mistakes (word omission, substitution, addition of unauthorized words) and Half Mistakes (spelling errors, wrong capitalization/punctuation, paragraph spacing errors). Net words are calculated by deducting the penalty from gross words typed."
  },
  {
    question: "Can I practice Hindi typing on TypeBaazi with a regular physical QWERTY keyboard?",
    answer: "Yes! TypeBaazi automatically translates your physical QWERTY keypresses into standard Devanagari InScript characters. You do not need any special hardware; the on-screen virtual keyboard visually guides every keystroke."
  },
  {
    question: "How many days of daily practice are needed to reach 30 WPM in Hindi?",
    answer: "With 30 minutes of focused daily practice on TypeBaazi (10 mins home-row drills, 10 mins matras & conjuncts, 10 mins timed mock tests), complete beginners typically achieve 30 WPM with 95%+ accuracy within 30 to 45 days."
  }
];

const breadcrumbItems = [
  { name: "Home", url: "https://typebaazi.com/" },
  { name: "Hindi Typing Test Online", url: "https://typebaazi.com/hindi-typing-test" }
];
---

<Layout
  title={pageTitle}
  description={pageDesc}
  keywords={pageKeywords}
  lang="hi"
  activePath="/hindi-typing-test"
  faqItems={hindiFaqs}
  breadcrumbs={breadcrumbItems}
>
  <div class="container page-container">
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="bc-sep">/</span>
      <span class="bc-current">Hindi Typing Test</span>
    </nav>

    <!-- Header & Main H1 -->
    <header class="page-header">
      <div class="badge badge-gold">🇮🇳 Official Devanagari Hindi Speed Test</div>
      <h1 class="page-title">Hindi Typing Test Online</h1>
      <p class="page-sub">
        Practice Hindi typing online with TypeBaazi. Test your Hindi typing speed and accuracy with real Devanagari exam passages, track your Net WPM, and download official certificates.
      </p>
      <div class="header-cta-row">
        <a href="#hindi-test-arena" class="btn-primary start-typing-btn">
          <span>⚡ Start Hindi Typing Test Now</span>
        </a>
      </div>
    </header>

    <!-- Interactive Typing Arena -->
    <section class="arena-section" id="hindi-test-arena" aria-label="हिंदी टाइपिंग अरेना">
      <TypingArena initialLanguage="hindi" initialDuration={60} initialDifficulty="medium" showControls={true} />
      <VirtualKeyboard language="hindi" visible={true} />
    </section>

    <!-- Educational & Practical Guide -->
    <article class="hindi-info-panel glass-panel" itemscope itemtype="https://schema.org/Article">
      <header class="panel-header-block">
        <span class="badge badge-gold">🇮🇳 सरकारी परीक्षा मार्गदर्शिका</span>
        <h2 itemprop="headline">Comprehensive Hindi Devanagari Typing &amp; Government Exam Handbook</h2>
        <p class="panel-lead-text">
          Hindi Devanagari typing is a mandatory qualification for thousands of central and state government posts across India, including SSC CGL, SSC CHSL (Data Entry Skill Test - DEST), MP CPCT, High Court and District Court Clerks, Police Sub-Inspectors, and Railway RRB NTPC. This comprehensive guide outlines the mathematical WPM/KDPH conversion formulas, Devanagari InScript keyboard mechanics, conjunct formation rules, and error scoring standards.
        </p>
      </header>

      <!-- Section 1: WPM and KDPH Conversion -->
      <section class="guide-sub-section">
        <h3>1. The Mathematics of Hindi Typing: WPM &amp; Key Depressions Per Hour (KDPH)</h3>
        <p>
          Recruitment commissions evaluate typing through two primary metrics: <strong>Words Per Minute (WPM)</strong> and <strong>Key Depressions Per Hour (KDPH)</strong>. In standard government evaluation, 1 standardized word equals exactly <strong>5 keystrokes</strong> (including consonants, vowels, matras, halants, and spaces):
        </p>
        <div class="formula-grid-block">
          <div class="formula-box-card">
            <h4>Gross WPM (कच्ची गति)</h4>
            <code>Gross WPM = (Total Keystrokes / 5) / Time (Minutes)</code>
            <p>Measures your raw finger agility across all characters typed in the time limit.</p>
          </div>
          <div class="formula-box-card">
            <h4>Net WPM (शुद्ध गति)</h4>
            <code>Net WPM = Gross WPM − (Mistakes / Time in Minutes)</code>
            <p>The definitive qualifying metric used to determine pass/fail status in recruitment exams.</p>
          </div>
        </div>

        <div class="formula-box-card" style="margin-top: 14px;">
          <h4>KDPH to WPM Conversion Formula (SSC &amp; DEST Standard)</h4>
          <code>WPM = (Total Key Depressions / 5) / 60</code>
          <p>
            Example: An SSC requirement of <strong>9,000 KDPH</strong> translates to <code>9,000 / 5 = 1,800 words / 60 mins = 30 WPM</code> (or 1,500 key depressions in a 10-minute test). A requirement of <strong>10,500 KDPH</strong> translates to <code>35 WPM</code>.
          </p>
        </div>
      </section>

      <!-- Section 2: Recruitment Benchmarks Table -->
      <section class="guide-sub-section">
        <h3>2. Central &amp; State Government Hindi Typing Exam Benchmarks</h3>
        <p>
          Review the official qualifying criteria across prominent Indian competitive examinations:
        </p>

        <div class="table-responsive">
          <table class="exam-benchmarks-table">
            <thead>
              <tr>
                <th>Recruitment Examination</th>
                <th>Standard Keyboard Layout</th>
                <th>Required Speed</th>
                <th>Test Duration</th>
                <th>Permissible Error Limit</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>SSC CHSL / CGL (DEST)</strong></td>
                <td>Devanagari InScript / Remington</td>
                <td>30 WPM (9,000 KDPH)</td>
                <td>10 Minutes / 15 Minutes</td>
                <td>5% (UR) / 7% (Reserved)</td>
              </tr>
              <tr>
                <td><strong>MP CPCT (Madhya Pradesh)</strong></td>
                <td>InScript / Remington Gail</td>
                <td>20 WPM (Min Qualifying) / 30+ (High Score)</td>
                <td>15 Minutes</td>
                <td>Strict Net WPM Penalty</td>
              </tr>
              <tr>
                <td><strong>Allahabad / Patna High Court Clerk</strong></td>
                <td>InScript / Remington</td>
                <td>25 to 30 WPM</td>
                <td>10 Minutes</td>
                <td>10% Maximum Mistake Cap</td>
              </tr>
              <tr>
                <td><strong>Railway RRB NTPC (Junior Clerk)</strong></td>
                <td>Devanagari InScript</td>
                <td>30 WPM</td>
                <td>10 Minutes</td>
                <td>5% Permissible Mistakes</td>
              </tr>
              <tr>
                <td><strong>State PSC (UPPSC, BPSC, UKPSC)</strong></td>
                <td>InScript / Kruti Dev / Remington</td>
                <td>25 to 30 WPM</td>
                <td>5 to 10 Minutes</td>
                <td>Strict Net Evaluation</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 3: InScript vs Remington Comparison -->
      <section class="guide-sub-section">
        <h3>3. Devanagari InScript vs. Remington Keyboard Layout Comparison</h3>
        <p>
          Understanding the structural differences between InScript and Remington helps typists choose the best approach for their target examination:
        </p>

        <div class="table-responsive">
          <table class="exam-benchmarks-table">
            <thead>
              <tr>
                <th>Feature / Characteristic</th>
                <th>Devanagari InScript Layout</th>
                <th>Remington Gail / CBI Layout</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Standardization Authority</strong></td>
                <td>Government of India &amp; Bureau of Indian Standards (BIS)</td>
                <td>Traditional Typewriter Manufacturers</td>
              </tr>
              <tr>
                <td><strong>Operating System Support</strong></td>
                <td>Natively built into Windows, macOS, Android, Linux, iOS</td>
                <td>Requires special font installation or third-party IME</td>
              </tr>
              <tr>
                <td><strong>Linguistic Logic</strong></td>
                <td>Vowels/matras on left hand; Consonants on right hand</td>
                <td>Mechanical placement based on mechanical typewriter arms</td>
              </tr>
              <tr>
                <td><strong>Unicode Compliance</strong></td>
                <td>100% universal Unicode standard; works across all modern web apps</td>
                <td>Often dependent on legacy 8-bit fonts (Kruti Dev / Devlys)</td>
              </tr>
              <tr>
                <td><strong>Government Exam Preference</strong></td>
                <td>Mandatory or preferred in SSC, RRB, UPSC, High Courts</td>
                <td>Permitted in select state exams (MP CPCT, UP Police)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 4: Conjunct (संयुक्ताक्षर) Formation Guide -->
      <section class="guide-sub-section">
        <h3>4. How to Type Conjuncts (संयुक्ताक्षर) in Devanagari InScript</h3>
        <p>
          In InScript, any joint character is formed by typing the first consonant, pressing the <strong>Halant (Virama / 'd' key)</strong>, and then typing the second consonant. Review the essential combinations:
        </p>

        <div class="table-responsive">
          <table class="exam-benchmarks-table">
            <thead>
              <tr>
                <th>संयुक्त वर्ण (Conjunct)</th>
                <th>वर्ण विच्छेद (Sequence)</th>
                <th>InScript Physical Keys</th>
                <th>उदाहरण शब्द (Examples)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>क्ष</strong></td>
                <td>क + ् + ष</td>
                <td><code>k</code> + <code>d</code> + <code>Shift + ,</code></td>
                <td>परीक्षा, कक्षा, रक्षक</td>
              </tr>
              <tr>
                <td><strong>त्र</strong></td>
                <td>त + ् + र</td>
                <td><code>l</code> + <code>d</code> + <code>j</code></td>
                <td>पत्र, त्रिशूल, छात्र</td>
              </tr>
              <tr>
                <td><strong>ज्ञ</strong></td>
                <td>ज + ् + ञ</td>
                <td><code>p</code> + <code>d</code> + <code>Shift + &#125;</code></td>
                <td>ज्ञान, प्रज्ञा, वैज्ञानिक</td>
              </tr>
              <tr>
                <td><strong>श्र</strong></td>
                <td>श + ् + र</td>
                <td><code>Shift + m</code> + <code>d</code> + <code>j</code></td>
                <td>श्रीमान, श्रम, विश्राम</td>
              </tr>
              <tr>
                <td><strong>प्र</strong></td>
                <td>प + ् + र</td>
                <td><code>h</code> + <code>d</code> + <code>j</code></td>
                <td>प्रकाश, प्रगति, प्रभाव</td>
              </tr>
              <tr>
                <td><strong>द्ध</strong></td>
                <td>द + ् + ध</td>
                <td><code>o</code> + <code>d</code> + <code>Shift + o</code></td>
                <td>शुद्ध, युद्ध, बुद्धि</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 5: Full vs Half Mistake Classification -->
      <section class="guide-sub-section">
        <h3>5. Error Scoring Standards: Full Mistakes vs. Half Mistakes</h3>
        <div class="tips-grid">
          <div class="tip-card">
            <span class="tip-icon">❌</span>
            <h4>Full Mistakes (पूर्ण त्रुटि)</h4>
            <p>Omission of words, substitution of incorrect words, addition of extra words not in passage, or spelling mistakes in key nouns. Deducts 1 full word or 1 mark.</p>
          </div>
          <div class="tip-card">
            <span class="tip-icon">⚠️</span>
            <h4>Half Mistakes (अर्ध त्रुटि)</h4>
            <p>Spacing errors (extra space or missing space between words), incorrect punctuation marks, or minor matra positioning errors. Deducts 0.5 words or marks.</p>
          </div>
          <div class="tip-card">
            <span class="tip-icon">🎯</span>
            <h4>Accuracy Threshold Strategy</h4>
            <p>Typing at 32 WPM with 98% accuracy always passes, whereas typing at 45 WPM with 88% accuracy fails due to cumulative mistake penalties.</p>
          </div>
          <div class="tip-card">
            <span class="tip-icon">⏱️</span>
            <h4>Steady Rhythm Pacing</h4>
            <p>Maintain consistent keystroke tempo. Speed bursts followed by pauses create irregular keystroke intervals and increase typo probability.</p>
          </div>
        </div>
      </section>

      <!-- Contextual Internal Linking -->
      <div class="related-links-box">
        <h3>Explore Other TypeBaazi Practice Hubs</h3>
        <div class="links-grid">
          <a href="/seven-minute-typing-test/" class="hub-link-card">
            <span class="hub-icon">⏱️</span>
            <div>
              <strong>7-Minute Exam Simulator</strong>
              <span>Full 30 &amp; 40 WPM mock test with real exam evaluation.</span>
            </div>
          </a>
          <a href="/hindi-typing-practice/" class="hub-link-card">
            <span class="hub-icon">✍️</span>
            <div>
              <strong>Hindi Typing Practice</strong>
              <span>Untimed Devanagari key drills &amp; letter practice.</span>
            </div>
          </a>
          <a href="/guides/hindi-typing-exam-preparation/" class="hub-link-card">
            <span class="hub-icon">📚</span>
            <div>
              <strong>Hindi Exam Preparation Guide</strong>
              <span>Complete handbook for SSC, RRB &amp; Court recruitment.</span>
            </div>
          </a>
          <a href="/marathi-typing-test/" class="hub-link-card">
            <span class="hub-icon">🇮🇳</span>
            <div>
              <strong>Marathi Typing Test</strong>
              <span>Devanagari Marathi speed test &amp; GCC-TBC prep.</span>
            </div>
          </a>
          <a href="/typing-speed-test/" class="hub-link-card">
            <span class="hub-icon">⚡</span>
            <div>
              <strong>Typing Speed Test</strong>
              <span>1-Minute online WPM calculator &amp; free certificate.</span>
            </div>
          </a>
          <a href="/government-exam-typing-practice/" class="hub-link-card">
            <span class="hub-icon">🏛️</span>
            <div>
              <strong>Government Exam Typing Practice</strong>
              <span>SSC, Court, and State exam simulation hub.</span>
            </div>
          </a>
        </div>
      </div>

      <!-- FAQ Accordion -->
      <div class="seo-faq-block" style="margin-top: 24px;">
        <h3>Frequently Asked Questions (हिंदी टाइपिंग FAQ)</h3>
        <div class="faq-accordion">
          {hindiFaqs.map((item) => (
            <details class="faq-item">
              <summary class="faq-question">
                <span>{item.question}</span>
                <span class="faq-arrow">&darr;</span>
              </summary>
              <div class="faq-answer">
                <p>{item.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </article>
  </div>
</Layout>

<style is:global>
  .page-container {
    padding: clamp(16px, 2.5vw, 24px) clamp(12px, 2vw, 20px) 50px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .breadcrumb-nav a {
    color: var(--accent-gold);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .breadcrumb-nav a:hover {
    text-decoration: underline;
  }

  .bc-sep {
    opacity: 0.4;
  }

  .bc-current {
    color: var(--text-main);
    font-weight: 600;
  }

  .page-header {
    text-align: center;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .page-title {
    font-size: clamp(24px, 4.5vw, 36px);
    font-weight: 900;
    color: #ffffff;
    margin: 8px 0 10px;
    line-height: 1.25;
    letter-spacing: -0.5px;
    font-family: var(--font-marathi);
  }

  .page-sub {
    font-size: clamp(14px, 2vw, 16px);
    color: var(--text-muted);
    max-width: 780px;
    margin: 0 auto 16px;
    line-height: 1.55;
  }

  .header-cta-row {
    margin-top: 4px;
  }

  .start-typing-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 18px var(--accent-gold-glow);
    transition: all 0.2s ease;
  }

  .start-typing-btn:hover {
    transform: translateY(-2px);
  }

  .arena-section {
    margin-bottom: 36px;
  }

  /* Educational Info Panel */
  .hindi-info-panel {
    padding: clamp(20px, 3.5vw, 36px);
    border-radius: var(--radius-lg);
    background: rgba(12, 18, 30, 0.7);
    border: 1px solid var(--border-subtle);
    margin-top: 24px;
  }

  .hindi-info-panel h2 {
    font-size: clamp(20px, 3vw, 24px);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hindi-info-panel h2:not(:first-child) {
    margin-top: 32px;
  }

  .panel-text {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 16px;
  }

  .tips-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin-top: 18px;
  }

  .tip-card {
    padding: 18px;
    background: rgba(18, 27, 46, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .tip-card:hover {
    transform: translateY(-2px);
    border-color: rgba(251, 191, 36, 0.3);
  }

  .tip-icon {
    font-size: 24px;
    display: block;
    margin-bottom: 8px;
  }

  .tip-card h4 {
    font-size: 15px;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 6px;
  }

  .tip-card p {
    font-size: 13.5px;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* Related Links */
  .related-links-box {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
  }

  .related-links-box h3 {
    font-size: 18px;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 16px;
  }

  .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }

  .hub-link-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
    background: rgba(18, 27, 46, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
  }

  .hub-link-card:hover {
    background: rgba(251, 191, 36, 0.08);
    border-color: rgba(251, 191, 36, 0.3);
    transform: translateY(-2px);
  }

  .hub-icon {
    font-size: 22px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .hub-link-card strong {
    display: block;
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 2px;
  }

  .hub-link-card span {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.35;
  }

  /* SEO FAQ Block */
  .seo-faq-block {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
  }

  .seo-faq-block h3 {
    font-size: 18px;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 16px;
  }

  .faq-item {
    margin-bottom: 16px;
    padding: 14px 16px;
