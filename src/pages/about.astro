<script>
  // Tab switching logic + Hash routing support (e.g. /about#contact)
  const tabBtns = document.querySelectorAll('.about-tab-btn');
  const tabContents = document.querySelectorAll('.about-tab-content');

  function switchTab(targetId: string) {
    tabBtns.forEach(btn => {
      if (btn.getAttribute('data-tab') === targetId) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    tabContents.forEach(content => {
      if (content.id === targetId) {
        content.classList.add('active');
      } else {
        content.classList.remove('active');
      }
    });
  }

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab');
      if (target) {
        switchTab(target);
        window.history.replaceState(null, '', `#${target.replace('tab-', '')}`);
      }
    });
  });

  // Check URL hash on page load
  const hash = window.location.hash.toLowerCase().replace('#', '');
  if (hash === 'learn' || hash === 'learn-typing') {
    switchTab('tab-learn');
  } else if (hash === 'contact' || hash === 'contact-us') {
    switchTab('tab-contact');
  } else if (hash === 'privacy' || hash === 'privacy-policy') {
    switchTab('tab-privacy');
  } else if (hash === 'terms' || hash === 'terms-and-conditions') {
    switchTab('tab-terms');
  } else if (hash === 'faq' || hash === 'faq-section') {
    switchTab('tab-faq');
  }

  // Unified Contact Form Submission
  const unifiedForm = document.getElementById('unified-contact-form') as HTMLFormElement | null;
  const unifiedSubmitBtn = document.getElementById('unified-submit-btn') as HTMLButtonElement | null;
  const unifiedBtnText = document.getElementById('unified-btn-text');
  const unifiedSuccessMsg = document.getElementById('unified-success-msg');

  unifiedForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (unifiedSubmitBtn) unifiedSubmitBtn.disabled = true;
    if (unifiedBtnText) unifiedBtnText.textContent = '⏳ Sending to riteshthakareofficial@gmail.com...';

    setTimeout(() => {
      if (unifiedBtnText) unifiedBtnText.textContent = '✓ Sent!';
      if (unifiedSuccessMsg) unifiedSuccessMsg.classList.remove('hidden');
      unifiedForm.reset();

      setTimeout(() => {
        if (unifiedSubmitBtn) unifiedSubmitBtn.disabled = false;
        if (unifiedBtnText) unifiedBtnText.textContent = '🚀 Send Message to riteshthakareofficial@gmail.com';
      }, 4000);
    }, 900);
  });
</script>
