---
import Layout from '../layouts/Layout.astro';
import StatsDashboard from '../components/StatsDashboard.astro';
---

<Layout
  title="Typing Dashboard & Free Speed Certificates Online — Personal Bests & Badges | TypeBaazi"
  description="View your personal typing statistics, WPM speed charts, accuracy history, and download official free typing certificates in PDF & PNG format on TypeBaazi."
  keywords="typing certificate, free typing certificate online, download typing certificate, typing test certificate, verified typing speed certificate, typebaazi dashboard, typing badges, wpm analytics"
  activePath="/dashboard"
>
  <div class="container page-container">
    <div class="page-header">
      <div class="badge badge-cyan">📊 Typist Profile &amp; Analytics</div>
      <h1 class="page-title">Personal Speed Dashboard</h1>
      <p class="page-sub">
        Review your typing speed milestones, accuracy records, level progression, and historical speed graphs.
      </p>

      <!-- Hub Nav Tabs -->
      <div class="hub-nav-tabs">
        <a href="/leaderboard/" class="hub-tab">
          <span>🏆 Global Rankings &amp; Championship</span>
        </a>
        <a href="/dashboard/" class="hub-tab active">
          <span>📊 My Stats &amp; Dashboard</span>
        </a>
      </div>
    </div>

    <!-- Complete Stats Dashboard Component -->
    <StatsDashboard />
  </div>
</Layout>

<style>
  .page-container {
    padding: clamp(16px, 3vw, 36px) clamp(8px, 2vw, 20px) 60px;
    max-width: 1080px;
    margin: 0 auto;
    box-sizing: border-box;
    width: 100%;
  }

  .page-header {
    text-align: center;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .page-title {
    font-size: clamp(22px, 4.5vw, 36px);
    font-weight: 900;
    color: #ffffff;
    margin: 6px 0;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .page-sub {
    font-size: clamp(12.5px, 1.6vw, 15px);
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto 18px;
  }

  .hub-nav-tabs {
    display: inline-flex;
    align-items: center;
    background: rgba(18, 27, 46, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-pill);
    padding: 5px;
    gap: 6px;
    margin-top: 6px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .hub-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 20px;
    border-radius: var(--radius-pill);
    font-size: 14px;
    font-weight: 700;
    color: #e2e8f0;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .hub-tab:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
  }

  .hub-tab.active {
    background: linear-gradient(135deg, #0070f3, #7928ca);
    color: #ffffff;
    font-weight: 800;
    box-shadow: 0 2px 12px rgba(0, 112, 243, 0.4);
  }

  @media (max-width: 600px) {
    .hub-nav-tabs {
      width: 100%;
      flex-direction: column;
      border-radius: var(--radius-md);
      padding: 4px;
    }
    .hub-tab {
      width: 100%;
      justify-content: center;
      border-radius: var(--radius-sm);
      padding: 10px 14px;
      font-size: 13px;
    }
  }

  /* Explicit Light Theme Overrides */
  [data-theme='light'] .hub-nav-tabs {
    background: #e2e8f0 !important;
    border: 1px solid #cbd5e1 !important;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.06), 0 2px 8px rgba(0, 0, 0, 0.04) !important;
  }

  [data-theme='light'] .hub-tab {
    color: #1e293b !important;
    font-weight: 700 !important;
  }

  [data-theme='light'] .hub-tab:hover {
    color: #0f172a !important;
    background: rgba(255, 255, 255, 0.7) !important;
  }

  [data-theme='light'] .hub-tab.active {
    background: linear-gradient(135deg, #0070f3, #7928ca) !important;
    color: #ffffff !important;
    font-weight: 800 !important;
    box-shadow: 0 2px 10px rgba(0, 112, 243, 0.3) !important;
  }

  [data-theme='light'] .page-title {
    color: #0f172a !important;
  }

  [data-theme='light'] .page-sub {
    color: #475569 !important;
  }
</style>
