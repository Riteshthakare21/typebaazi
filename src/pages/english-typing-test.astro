    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 18px;
    box-sizing: border-box;
  }

  .tip-icon {
    font-size: 24px;
    display: block;
    margin-bottom: 8px;
  }

  .tip-card h4 {
    font-size: 15px;
    font-weight: 800;
    color: #00f0ff;
    margin: 0 0 6px;
  }

  .tip-card p {
    font-size: 13px;
    color: #cbd5e1;
    line-height: 1.5;
    margin: 0;
  }

  .related-links-box {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .related-links-box h3 {
    font-size: 16px;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 14px;
  }

  .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 12px;
  }

  .hub-link-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(15, 23, 42, 0.9);
    border: 1.5px solid rgba(0, 240, 255, 0.2);
    border-radius: 12px;
    padding: 12px 14px;
    text-decoration: none;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .hub-icon {
    font-size: 24px;
    flex-shrink: 0;
  }

  .hub-link-card strong {
    font-size: 13.5px;
    color: #ffffff;
    display: block;
  }

  .hub-link-card span {
    font-size: 11.5px;
    color: #94a3b8;
    display: block;
    margin-top: 2px;
  }

  .hub-link-card:hover {
    border-color: #00f0ff;
    background: rgba(0, 240, 255, 0.08);
    transform: translateY(-2px);
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .faq-item {
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 14px 18px;
  }

  .faq-item[open] {
    border-color: rgba(0, 240, 255, 0.4);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-size: 14.5px;
    font-weight: 700;
    color: #ffffff;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-arrow {
    color: #00f0ff;
    font-size: 16px;
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }

  .faq-answer {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .faq-answer p {
    font-size: 13px;
    color: #cbd5e1;
    line-height: 1.6;
