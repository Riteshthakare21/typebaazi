    border-color: #e2e8f0 !important;
  }

  [data-theme='light'] .timeline-step strong,
  [data-theme='light'] .math-breakdown-box h3 {
    color: #0f172a !important;
  }

  [data-theme='light'] .timeline-step p {
    color: #475569 !important;
  }

  [data-theme='light'] .formula-box {
    background: #f0f9ff !important;
    border-color: #0284c7 !important;
  }

  [data-theme='light'] .formula-box code {
    color: #0369a1 !important;
  }

  .math-breakdown-box {
    background: rgba(15, 23, 42, 0.95);
    border: 1.5px solid rgba(0, 240, 255, 0.25);
    border-radius: 16px;
    padding: 22px;
    margin: 24px 0;
  }

  .math-breakdown-box h3 {
    font-size: 17px;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 8px;
  }

  .error-timeline-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    margin: 16px 0;
  }

  .timeline-step {
    background: rgba(8, 12, 22, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 14px;
  }

  .step-ms {
    display: inline-block;
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
    font-size: 11.5px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 5px;
    font-family: var(--font-mono, monospace);
    margin-bottom: 6px;
  }

  .timeline-step strong {
    display: block;
    font-size: 13.5px;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .timeline-step p {
    font-size: 12px;
    color: #94a3b8;
    line-height: 1.45;
    margin: 0;
  }

  .formula-box {
    background: rgba(0, 240, 255, 0.06);
    border: 1px dashed rgba(0, 240, 255, 0.3);
    border-radius: 10px;
    padding: 12px 16px;
  }

  .formula-box code {
    font-size: 13px;
    font-weight: 700;
    color: #00f0ff;
    font-family: var(--font-mono, monospace);
  }

  /* Light Theme */
  [data-theme='light'] .page-title,
  [data-theme='light'] .guide-panel h2,
  [data-theme='light'] .faq-panel h2,
  [data-theme='light'] .related-links-box h3,
  [data-theme='light'] .faq-question {
