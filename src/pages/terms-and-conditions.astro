---
import Layout from '../layouts/Layout.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://typebaazi.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Terms and Conditions",
      "item": "https://typebaazi.com/terms-and-conditions"
    }
  ]
};
---

<Layout
  title="Terms & Conditions — TypeBaazi Free Typing Platform"
  description="Review TypeBaazi's Terms and Conditions. Understand terms of service, fair play rules, acceptable use, intellectual property, and service guidelines."
  activePath="/terms-and-conditions"
  keywords="typebaazi terms and conditions, typing test terms of service, acceptable use policy"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="container page-container">
    <div class="page-header">
      <div class="badge badge-gold">📜 Terms of Service</div>
      <h1 class="page-title">Terms &amp; Conditions</h1>
      <p class="page-sub">
        Last Updated: August 2026 • <em>Please read these terms carefully before using TypeBaazi.</em>
      </p>
    </div>

    <div class="legal-card glass-panel">
      <div class="legal-section">
        <h2>1. Acceptance of Terms</h2>
        <p>
          By accessing or using <strong>TypeBaazi</strong> via <code>https://typebaazi.com</code> or through our progressive web application (PWA) / Android APK, you agree to be bound by these Terms and Conditions. If you do not agree to these terms, please do not use our services.
        </p>
      </div>

      <div class="legal-section">
        <h2>2. Educational &amp; Entertainment Purpose</h2>
        <p>
          TypeBaazi provides free trilingual English, Hindi, and Marathi typing tests, racing games, and practice modules intended solely for educational, personal improvement, and entertainment purposes. We strive for high accuracy in WPM and Net WPM scoring, but results are not legal certifications unless verified in person at official government GCC-TBC testing centers.
        </p>
      </div>

      <div class="legal-section">
        <h2>3. Fair Play &amp; Leaderboard Integrity</h2>
        <p>
          To maintain fair competition for all global typists:
        </p>
        <ul class="legal-bullets">
          <li><strong>No Automated Scripts or Bots:</strong> Users are strictly prohibited from using automated typing bots, macros, autohotkey scripts, or browser extensions to generate false typing scores on the public Hall of Fame.</li>
          <li><strong>No Reverse Engineering:</strong> You agree not to decompile, reverse engineer, or exploit any vulnerabilities in the typing engine or racing game mechanics.</li>
        </ul>
      </div>

      <div class="legal-section">
        <h2>4. User Accounts, Local Profiles &amp; Data</h2>
        <p>
          TypeBaazi operates without requiring mandatory user registration for standard typing practice, racing, and speed tests. Any profile names, avatars, and test records saved on your device remain in your local browser memory (<code>localStorage</code>). You are responsible for maintaining the security of your device and browser data.
        </p>
      </div>

      <div class="legal-section">
        <h2>5. Intellectual Property Rights</h2>
        <p>
          All trademarks, logos, audio synthesizers, visual designs, vector car assets, and original code comprising TypeBaazi are the exclusive intellectual property of the TypeBaazi development team. You may not copy, reproduce, or redistribute any portion of this website without prior written permission.
        </p>
      </div>

      <div class="legal-section">
        <h2>6. Disclaimer of Warranties</h2>
        <p>
          TypeBaazi is provided on an <strong>"AS IS"</strong> and <strong>"AS AVAILABLE"</strong> basis without warranties of any kind, either express or implied. For detailed information regarding our speed calculation formula and non-affiliation with government exam bodies, please refer to our <a href="/disclaimer/" style="color: var(--accent-cyan);"><strong>Disclaimer</strong></a>.
        </p>
      </div>

      <div class="legal-section">
        <h2>7. Limitation of Liability</h2>
        <p>
          In no event shall TypeBaazi or its creators be liable for any direct, indirect, incidental, or consequential damages resulting from the use or inability to use this platform, including loss of local storage data or device battery drain.
        </p>
      </div>

      <div class="legal-section">
        <h2>8. Contact &amp; Questions</h2>
        <p>
          For legal inquiries or questions regarding our terms, please contact us via our <a href="/contact-us/" style="color: var(--accent-cyan);">Contact Us</a> page or email <a href="mailto:riteshthakareofficial@gmail.com" style="color: var(--accent-cyan);"><strong>riteshthakareofficial@gmail.com</strong></a>.
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-container {
    padding: clamp(24px, 4vw, 48px) clamp(12px, 2.5vw, 24px) 60px;
    max-width: 900px;
    margin: 0 auto;
    box-sizing: border-box;
    width: 100%;
  }

  .page-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .page-title {
    font-size: clamp(26px, 5vw, 38px);
    font-weight: 900;
    color: #ffffff;
    margin: 10px 0 6px;
    line-height: 1.2;
  }

  .page-sub {
    font-size: clamp(13px, 2vw, 15px);
    color: var(--text-muted, #94a3b8);
    margin: 0;
  }

  .legal-card {
    padding: clamp(20px, 4vw, 40px);
    border-radius: var(--radius-xl, 20px);
    border: 1.5px solid rgba(251, 191, 36, 0.35);
    display: flex;
    flex-direction: column;
    gap: 28px;
    box-sizing: border-box;
  }

  .legal-section h2 {
    font-size: clamp(17px, 2.8vw, 21px);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .legal-section p {
    font-size: clamp(13.5px, 1.8vw, 15px);
    color: var(--text-muted, #94a3b8);
    line-height: 1.65;
    margin: 0 0 10px;
  }

  .legal-bullets {
    margin: 8px 0 12px;
    padding-left: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .legal-bullets li {
    font-size: clamp(13px, 1.8vw, 14.5px);
    color: var(--text-muted, #94a3b8);
    line-height: 1.55;
  }

  .legal-bullets strong {
    color: #ffffff;
  }

  [data-theme='light'] .legal-card {
    background: #ffffff !important;
    border-color: #e2e8f0 !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05) !important;
  }

  [data-theme='light'] .legal-section h2 {
    color: #0f172a !important;
  }

  [data-theme='light'] .legal-section p,
  [data-theme='light'] .legal-bullets li {
    color: #475569 !important;
  }

  [data-theme='light'] .legal-bullets strong {
    color: #0f172a !important;
  }
</style>
