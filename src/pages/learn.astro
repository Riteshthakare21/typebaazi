---
import Layout from '../layouts/Layout.astro';
import LearnGuide from '../components/LearnGuide.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://typebaazi.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Learn Touch Typing",
      "item": "https://typebaazi.com/learn"
    }
  ]
};
---

<Layout
  title="Learn Touch Typing — Free Tutorials & Finger Placement Guide | TypeBaazi"
  description="Master touch typing with our free comprehensive guide. Learn home row finger placement, posture, WPM benchmarks, and English, Hindi and Marathi Devanagari typing on TypeBaazi."
  keywords="learn touch typing, typing tutorial, touch typing guide, finger placement typing, hindi typing guide, marathi typing guide, devanagari inscript guide, wpm typing tips, typebaazi"
  activePath="/learn"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="container page-container">
    <div class="page-header">
      <div class="badge badge-cyan">📖 Touch Typing Academy</div>
      <h1 class="page-title">How to Type Faster &amp; Smarter</h1>
      <p class="page-sub">
        Explore structured lessons on finger ergonomics, keyboard muscle memory, and English, Hindi &amp; Marathi Devanagari typing techniques.
      </p>
    </div>

    <!-- Learn Guide Component -->
    <LearnGuide />

    <!-- In-Depth Typing Guides Hub Strip -->
    <section class="learn-guides-feature-box glass-panel" style="margin-top: 40px; padding: 26px; border-radius: 16px; background: rgba(14, 21, 37, 0.85); border: 1.5px solid rgba(0, 240, 255, 0.25);">
      <h3 style="font-size: 20px; font-weight: 800; color: #ffffff; margin-bottom: 8px;">📚 Comprehensive Specialized Typing Handbooks</h3>
      <p style="font-size: 14px; color: var(--text-muted, #94a3b8); line-height: 1.6; margin-bottom: 18px;">
        Take your touch typing education further with our authoritative, free technical guides:
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-bottom: 20px;">
        <a href="/guides/touch-typing-rules-ergonomics/" class="btn-secondary" style="font-size: 13.5px; padding: 12px 16px; justify-content: flex-start; text-align: left;">
          <span>🖐️ Touch Typing Rules &amp; Posture Ergonomics</span>
        </a>
        <a href="/guides/marathi-inscript-keyboard-guide/" class="btn-secondary" style="font-size: 13.5px; padding: 12px 16px; justify-content: flex-start; text-align: left;">
          <span>⌨️ Marathi Devanagari Inscript Keyboard Guide</span>
        </a>
        <a href="/guides/gcc-tbc-exam-guide/" class="btn-secondary" style="font-size: 13.5px; padding: 12px 16px; justify-content: flex-start; text-align: left;">
          <span>📝 MSCE GCC-TBC Maharashtra Examination Guide</span>
        </a>
        <a href="/guides/hindi-typing-exam-preparation/" class="btn-secondary" style="font-size: 13.5px; padding: 12px 16px; justify-content: flex-start; text-align: left;">
          <span>🇮🇳 Hindi Exam Typing Guide (SSC, RRB, Courts)</span>
        </a>
        <a href="/guides/wpm-accuracy-calculation/" class="btn-secondary" style="font-size: 13.5px; padding: 12px 16px; justify-content: flex-start; text-align: left;">
          <span>📊 The Mathematics of WPM &amp; Net Accuracy</span>
        </a>
        <a href="/guides/" class="btn-secondary" style="font-size: 13.5px; padding: 12px 16px; justify-content: flex-start; text-align: left;">
          <span>📚 All Typing Guides &amp; Resources Hub</span>
        </a>
      </div>

      <div style="display: flex; flex-wrap: wrap; gap: 10px; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 16px;">
        <a href="/typing-test/" class="btn-primary" style="font-size: 13px; padding: 8px 18px;">
          <span>⚡ Start 1-Minute Speed Test</span>
        </a>
        <a href="/seven-minute-typing-test/" class="btn-secondary" style="font-size: 13px; padding: 8px 18px;">
          <span>⏱️ Practice 7-Min Exam</span>
        </a>
        <a href="/race/" class="btn-secondary" style="font-size: 13px; padding: 8px 18px;">
          <span>🏎️ AI Car Typing Race</span>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-container {
    padding: 40px 20px 60px;
  }

  .page-header {
    text-align: center;
    margin-bottom: 24px;
  }

  .page-title {
    font-size: 36px;
    font-weight: 900;
    color: #ffffff;
    margin: 8px 0;
  }

  .page-sub {
    font-size: 16px;
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto;
  }
</style>
