---
import Layout from '../layouts/Layout.astro';
import RaceTrack from '../components/RaceTrack.astro';
import VirtualKeyboard from '../components/VirtualKeyboard.astro';

const raceFaqs = [
  {
    question: "How does the TypeBaazi Grand Prix Typing Car Race work?",
    answer: "You control a high-speed vector racing car on an animated cyber track. Every accurate character you type moves your car forward along the track. Typing with sustained high WPM and 98%+ accuracy ignites rear nitro flames, providing acceleration to overtake the adaptive AI opponent and cross the finish line."
  },
  {
    question: "Can I race in Hindi and Marathi as well as English?",
    answer: "Yes! TypeBaazi is the world's only platform supporting trilingual real-time AI car racing across English QWERTY, Hindi Devanagari InScript, and Marathi Devanagari Inscript layouts with live character resolution."
  },
  {
    question: "How does the AI Bot calculate its speed during the race?",
    answer: "The AI bot calculates its speed using calibrated difficulty tiers: Easy (~25 WPM), Medium (~45 WPM), Hard (~70 WPM), and Extreme (~95+ WPM). The AI simulates human keystroke variance with natural speed fluctuations and slight pauses between phrases."
  },
  {
    question: "What is Nitro Overdrive and how do I activate it?",
    answer: "Nitro Overdrive activates automatically whenever your typing velocity exceeds 75 WPM while maintaining zero consecutive errors. It displays visual particle exhaust flames and surges your vehicle ahead of the competition."
  },
  {
    question: "Do I get a verified certificate for winning the typing race?",
    answer: "Yes, when you defeat the AI bot and achieve 1st Place in the Grand Prix race, you unlock an official verified digital Certificate of Victory available in high-resolution 300 DPI PDF and PNG formats."
  },
  {
    question: "Why does racing against an AI bot improve typing speed faster than normal tests?",
    answer: "Racing creates healthy competitive stress and visual urgency that forces your brain to bypass subvocalization (saying words in your head) and adopt word-chunking — processing whole words at a glance through rapid muscle memory."
  }
];

const breadcrumbItems = [
  { name: "Home", url: "https://typebaazi.com/" },
  { name: "AI Car Typing Race", url: "https://typebaazi.com/race" }
];
---

<Layout
  title="Typing Race Game Online — #1 Car Race Game & Speed Duel | TypeBaazi"
  description="Play the ultimate free typing race game online! Race high-speed cars against smart AI bots with accurate keystrokes in English, Hindi & Marathi, win Grand Prix & download certificates."
  keywords="typing race game, race game, car typing race, car race typing game, typing games, nitro type alternative, typing speed race, english typing race, hindi typing race, marathi typing race, typebaazi grand prix"
  activePath="/race"
  faqItems={raceFaqs}
  breadcrumbs={breadcrumbItems}
>
  <!-- VideoGame Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VideoGame",
    "name": "TypeBaazi Grand Prix AI Car Race",
    "description": "Real-time vector car racing typing game where keyboard typing speed powers racing cars against intelligent AI opponents across English, Hindi, and Marathi.",
    "genre": ["Racing", "Educational", "Typing Game"],
    "playMode": "SinglePlayer",
    "applicationCategory": "GameApplication",
    "operatingSystem": "All (Web, Android, Windows, macOS, iOS)",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "INR"
    }
  })} />
  <div class="race-page-container" id="race-page-root">
    <!-- Compact Game Header -->
    <header class="race-page-header">
      <div class="header-badge-row">
        <span class="badge badge-pink">🏎️ TypeBaazi Grand Prix</span>
        <span class="header-tagline">AI Speed Duel • English, हिंदी &amp; मराठी</span>
      </div>
      <h1 class="page-title">Real-Time AI Typing Race</h1>
    </header>

    <!-- Main Active Race Game Viewport -->
    <main class="race-game-arena">
      <!-- The Dedicated Race Track Component -->
      <RaceTrack initialLanguage="english" initialDifficulty="medium" />

      <!-- Responsive Virtual Keyboard -->
      <VirtualKeyboard language="english" visible={true} />
    </main>

    <!-- Comprehensive Educational & Tactical Racing Guide (Always Visible) -->
    <article class="race-guide-section glass-panel" itemscope itemtype="https://schema.org/Article" style="margin-top: 18px; padding: 24px; border-radius: 16px;">
      <header class="guide-article-header" style="border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 16px; margin-bottom: 20px;">
        <span class="badge badge-pink">🏎️ Real-Time Competitive Gaming</span>
        <h2 itemprop="headline" style="font-size: 22px; font-weight: 900; color: #ffffff; margin: 8px 0 10px;">
          The Science of Gamified Typing: How Real-Time AI Racing Breaks Speed Plateaus
        </h2>
        <p style="font-size: 14.5px; color: var(--text-muted, #94a3b8); line-height: 1.6; margin: 0;">
          Traditional typing tests often lead to mental fatigue and flatlining speed plateaus around 45–50 WPM. The <strong>TypeBaazi Grand Prix AI Car Race</strong> leverages cognitive gamification, real-time visual pacing, and competitive pressure to stimulate faster motor reflex loops and encourage whole-word chunking across <strong>English</strong>, <strong>Hindi</strong>, and <strong>Marathi</strong>.
        </p>
      </header>

      <!-- Section 1: Racing Mechanics Grid -->
      <section class="guide-content-block" style="margin: 20px 0;">
        <h3 style="font-size: 17px; font-weight: 800; color: #ff007a; margin-bottom: 12px;">1. Core Game Mechanics &amp; Physics Simulation</h3>
        <div class="race-rules-grid">
          <div class="rule-box">
            <span class="rule-icon">🚦</span>
            <h4>3-2-1-GO Countdown</h4>
            <p>Audio countdown beeps and visual grid lights train you to prime your home row finger positioning before the race timer starts.</p>
          </div>
          <div class="rule-box">
            <span class="rule-icon">🚗</span>
            <h4>Dynamic Adaptive AI Driver</h4>
            <p>The virtual AI racer features calibrated human-like velocity variance across 4 tiers: Easy (~25 WPM), Medium (~45 WPM), Hard (~70 WPM), and Extreme (~95+ WPM).</p>
          </div>
          <div class="rule-box">
            <span class="rule-icon">🔥</span>
            <h4>Nitro Overdrive Burst</h4>
            <p>Maintain 75+ WPM with 100% accuracy to ignite twin rear nitro exhaust plumes, accelerating your car past the leading opponent.</p>
          </div>
          <div class="rule-box">
            <span class="rule-icon">🏆</span>
            <h4>Championship Honors &amp; PDF Seals</h4>
            <p>Winning 1st place in the Grand Prix awards bonus XP, updates your Hall of Fame rating, and generates a verified digital Certificate of Victory.</p>
          </div>
        </div>
      </section>

      <!-- Section 2: Pro Racing Tactics -->
      <section class="guide-content-block" style="margin: 24px 0;">
        <h3 style="font-size: 17px; font-weight: 800; color: #ff007a; margin-bottom: 10px;">2. Five Tactical Tips to Defeat the AI on Hard &amp; Extreme</h3>
        <ol class="steps-numbered-list" style="margin: 10px 0 16px 20px; color: var(--text-muted); font-size: 14px; line-height: 1.7;">
          <li><strong>Look Two Words Ahead:</strong> Never fixate on the character your finger is currently striking. Keep your eyes locked 2 words ahead so your subconscious can queue up keystroke sequences without hesitation.</li>
          <li><strong>Eliminate Backspace Spam:</strong> In high-speed duels, hitting backspace three times costs more forward distance than mistyping a single character. Keep your momentum steady and correct mistakes with single, disciplined strokes.</li>
          <li><strong>Master Spacebar Transitions:</strong> Spaces between words account for ~20% of all race keystrokes. Use your dominant thumb with minimal lift to ensure seamless transitions between words.</li>
          <li><strong>Leverage Trilingual InScript Mapping:</strong> Racing in Hindi or Marathi Devanagari utilizes Inscript key positions. Practice half-letters and common matras on the virtual keyboard to accelerate through complex Indic sentences.</li>
          <li><strong>Trigger Nitro in Straightaways:</strong> Build rhythm on common, shorter words to surge past the 75 WPM threshold and maintain the nitro burn across longer passages.</li>
        </ol>
      </section>

      <!-- Section 3: Educational Guides Direct Links -->
      <section class="guide-content-block" style="margin-top: 24px; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 18px;">
        <h3 style="font-size: 16px; font-weight: 800; color: #ffffff; margin-bottom: 12px;">📚 Master Touch Typing &amp; Exam Techniques</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px; margin-bottom: 20px;">
          <a href="/guides/touch-typing-rules-ergonomics/" class="btn-secondary" style="font-size: 13px; padding: 10px 14px; justify-content: flex-start; text-align: left;">
            <span>🖐️ Touch Typing Rules &amp; Posture Ergonomics</span>
          </a>
          <a href="/guides/wpm-accuracy-calculation/" class="btn-secondary" style="font-size: 13px; padding: 10px 14px; justify-content: flex-start; text-align: left;">
            <span>📊 The Mathematics of WPM &amp; Net Accuracy</span>
          </a>
          <a href="/guides/marathi-inscript-keyboard-guide/" class="btn-secondary" style="font-size: 13px; padding: 10px 14px; justify-content: flex-start; text-align: left;">
            <span>⌨️ Marathi Devanagari Inscript Keyboard Guide</span>
          </a>
          <a href="/guides/hindi-typing-exam-preparation/" class="btn-secondary" style="font-size: 13px; padding: 10px 14px; justify-content: flex-start; text-align: left;">
            <span>🇮🇳 Hindi Exam Typing Guide (SSC, RRB, Courts)</span>
          </a>
        </div>
      </section>

      <!-- Related Modes Navigation Strip -->
      <div class="race-related-strip" style="border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 16px;">
        <h4 style="font-size: 14.5px; font-weight: 800; color: #ffffff; margin-bottom: 10px;">⚡ Continue Your Typing Journey</h4>
        <div class="race-related-grid">
          <a href="/typing-test/" class="race-rel-card" data-analytics-cta="race_rel_typing_test">
            <span>⌨️ Online Typing Speed Test</span>
          </a>
          <a href="/daily-challenge/" class="race-rel-card" data-analytics-cta="race_rel_daily">
            <span>🔥 Daily Typing Challenge (+100 XP)</span>
          </a>
          <a href="/seven-minute-typing-test/" class="race-rel-card" data-analytics-cta="race_rel_7min">
            <span>⏱️ 7-Minute GCC-TBC Exam Test</span>
          </a>
          <a href="/games/" class="race-rel-card" data-analytics-cta="race_rel_games">
            <span>🎮 Falling Words Arcade Matrix</span>
          </a>
          <a href="/leaderboard/" class="race-rel-card" data-analytics-cta="race_rel_leaderboard">
            <span>🏆 Global Leaderboard &amp; Hall of Fame</span>
          </a>
        </div>
      </div>
    </article>
  </div>
</Layout>

<style is:global>
  .race-page-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: clamp(6px, 1.2vh, 14px) clamp(8px, 1.8vw, 16px) clamp(20px, 3vh, 40px);
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.2vh, 12px);
    box-sizing: border-box;
  }

  .race-page-header {
    text-align: center;
  }

  .header-badge-row {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 4px;
    flex-wrap: wrap;
  }

  .header-tagline {
    font-size: clamp(10.5px, 1.3vw, 12px);
    color: var(--text-muted);
    font-weight: 600;
    white-space: nowrap;
  }

  .page-title {
    font-size: clamp(20px, 4.5vw, 28px);
    font-weight: 900;
    color: #ffffff;
    margin: 2px 0 0;
    line-height: 1.2;
    background: linear-gradient(135deg, #ffffff 40%, var(--accent-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .race-game-arena {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /* Guide Accordion */
  .race-guide-section {
    margin-top: clamp(12px, 2vh, 24px);
    width: 100%;
  }

  .race-info-accordion {
    padding: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
    transition: all var(--transition-fast);
  }

  .accordion-summary {
    padding: clamp(10px, 1.5vw, 14px) clamp(14px, 2vw, 20px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    user-select: none;
    background: rgba(15, 23, 42, 0.6);
    list-style: none;
    font-size: clamp(12px, 1.5vw, 14px);
    font-weight: 700;
    color: var(--text-main);
  }

  .accordion-summary::-webkit-details-marker {
    display: none;
  }

  .accordion-summary:hover {
    background: rgba(0, 240, 255, 0.08);
    color: var(--accent-cyan);
  }

  .summary-chevron {
    font-size: 10px;
    transition: transform var(--transition-fast);
    color: var(--text-muted);
  }

  .race-info-accordion[open] .summary-chevron {
    transform: rotate(180deg);
  }

  .accordion-content {
    padding: clamp(12px, 2vw, 20px);
    background: rgba(8, 12, 20, 0.4);
    border-top: 1px solid var(--border-subtle);
  }

  .race-rules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: clamp(10px, 1.5vw, 16px);
  }

  .rule-box {
    background: rgba(12, 18, 30, 0.7);
    border: 1px solid var(--border-subtle);
    padding: clamp(10px, 1.5vw, 16px);
    border-radius: var(--radius-md);
  }

  .rule-icon {
    font-size: 22px;
    margin-bottom: 6px;
    display: block;
  }

  .rule-box h4 {
    font-size: clamp(12px, 1.4vw, 14px);
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .rule-box p {
    font-size: clamp(11px, 1.2vw, 12px);
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0;
  }

  /* Automatically collapse or dim distractions when racing */
  .is-racing-active .race-guide-section {
    opacity: 0.3;
    pointer-events: none;
  }

  /* Light Theme Overrides for Race Page */
  [data-theme='light'] .race-page-container .page-title {
    color: #0f172a !important;
    -webkit-text-fill-color: #0f172a !important;
    background: none !important;
  }

  [data-theme='light'] .header-tagline {
    color: #334155 !important;
  }

  [data-theme='light'] .race-info-accordion {
    background: #ffffff !important;
    border: 1.5px solid #e2e8f0 !important;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05) !important;
  }

  [data-theme='light'] .accordion-summary {
    background: #f8fafc !important;
    color: #0f172a !important;
    font-weight: 700 !important;
  }

  [data-theme='light'] .accordion-summary:hover {
    background: #eff6ff !important;
    color: #0070f3 !important;
  }

  [data-theme='light'] .summary-chevron {
    color: #0070f3 !important;
  }

  [data-theme='light'] .accordion-content {
    background: #ffffff !important;
    border-top: 1px solid #e2e8f0 !important;
  }

  /* Race Related Modes Grid */
  .race-related-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-top: 8px;
  }

  .race-rel-card {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    background: rgba(14, 21, 37, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-full, 9999px);
    font-size: 12.5px;
    font-weight: 700;
    color: #cbd5e1;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .race-rel-card:hover {
    background: rgba(0, 240, 255, 0.15);
    border-color: var(--accent-cyan, #00f0ff);
    color: #ffffff;
    transform: translateY(-2px);
  }

  [data-theme='light'] .race-related-strip h4 {
    color: #0f172a !important;
  }

  [data-theme='light'] .race-rel-card {
    background: #f1f5f9 !important;
    border: 1.5px solid #cbd5e1 !important;
    color: #1e293b !important;
  }

  [data-theme='light'] .race-rel-card:hover {
    background: #eff6ff !important;
    border-color: #0070f3 !important;
    color: #0070f3 !important;
  }
</style>

<script>
  const raceRoot = document.getElementById('race-page-root');
  const guideAccordion = document.getElementById('race-info-accordion') as HTMLDetailsElement;

  // Listen to race state change events
  window.addEventListener('race-state-change', (e: Event) => {
    const custom = e as CustomEvent<{ state: string }>;
    if (!custom.detail) return;

    if (custom.detail.state === 'racing') {
      raceRoot?.classList.add('is-racing-active');
      if (guideAccordion && guideAccordion.open) {
        guideAccordion.open = false;
      }
    } else {
      raceRoot?.classList.remove('is-racing-active');
    }
  });
</script>
