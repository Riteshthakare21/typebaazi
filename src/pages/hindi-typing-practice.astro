---
import Layout from "../layouts/Layout.astro";
import TypingArena from "../components/TypingArena.astro";
import VirtualKeyboard from "../components/VirtualKeyboard.astro";

const pageTitle =
  "Hindi Typing Practice Online (हिंदी टाइपिंग अभ्यास) | TypeBaazi";
const pageDesc =
  "Practice Hindi typing online for free. Master Devanagari keyboard layouts, vowels, consonants, and conjuncts (संयुक्ताक्षर) to increase your typing speed up to 40 WPM on TypeBaazi.";
const pageKeywords =
  "hindi typing practice online, hindi typing practice, हिंदी टाइपिंग सराव, learn hindi typing, devanagari typing practice, ssc hindi typing, inscript hindi typing, typebaazi";

const hindiPracticeFaqs = [
  {
    question: "हिंदी टाइपिंग अभ्यास की शुरुआत कैसे करें?",
    answer: "टाइपिंग की शुरुआत होम रो (Home Row) कीज़ से करें। अपने बाएं हाथ की उंगलियों को ASDF (ो े ् ि) पर और दाएं हाथ की उंगलियों को JKL; (र क त च) पर रखें। TypeBaazi के ऑन-स्क्रीन कीबोर्ड की सहायता से बिना कीबोर्ड को देखे टाइप करने का अभ्यास करें।"
  },
  {
    question: "सरकारी परीक्षाओं (SSC, CPCT, High Court) के लिए कौन सा कीबोर्ड लेआउट सही है?",
    answer: "भारत सरकार द्वारा मानकीकृत 'देवनागरी इनस्क्रिप्ट' (InScript) कीबोर्ड लेआउट सभी केंद्रीय और अधिकांश राज्य स्तरीय परीक्षाओं (SSC CGL/CHSL, Railway RRB, Courts) में अनिवार्य या अनुशंसित है। यह विंडोज़, मैक और मोबाइल में पहले से उपलब्ध रहता है।"
  },
  {
    question: "हिंदी इनस्क्रिप्ट में मात्राएँ (Matras) कैसे टाइप करें?",
    answer: "इनस्क्रिप्ट में पहले व्यंजन टाइप करें, फिर संबंधित मात्रा की की दबाएँ। जैसे 'कि' लिखने के लिए 'k' (क) फिर 'f' (ि) दबाएँ। 'कु' के लिए 'k' (क) फिर 'g' (ु) दबाएँ। 'का' के लिए 'k' (क) फिर 'e' (ा) दबाएँ।"
  },
  {
    question: "संयुक्त अक्षर (जैसे क्ष, त्र, ज्ञ, श्र) कैसे बनाए जाते हैं?",
    answer: "पहला व्यंजन टाइप करें, फिर हलंत ('d' की) दबाएँ, और फिर दूसरा व्यंजन दबाएँ। उदाहरण: क + ् (d) + ष (Shift+,) = क्ष; त + ् (d) + र (j) = त्र; ज + ् (d) + ञ (Shift+}) = ज्ञ; श + ् (d) + र (j) = श्र।"
  },
  {
    question: "नुक्ता वाले अक्षर (क़, ख़, ग़, ज़, ड़, ढ़, फ़) कैसे टाइप करें?",
    answer: "मूल अक्षर टाइप करने के तुरंत बाद नुक्ता की (']' की) दबाएँ। जैसे 'ज' (p) + '़' (]) = ज़; 'ड' ([) + '़' (]) = ड़; 'फ' (Shift+h) + '़' (]) = फ़।"
  },
  {
    question: "प्रतिदिन कितने समय अभ्यास करने से गति 30+ WPM हो सकती है?",
    answer: "प्रतिदिन 25 से 30 मिनट का नियमित अभ्यास पर्याप्त है। पहले 10 मिनट वर्णमाला और मात्राओं का अभ्यास करें, 10 मिनट कठिन संयुक्त शब्दों का अभ्यास करें, और 10 मिनट TypeBaazi पर टाइमर टेस्ट दें। 4 से 6 सप्ताह में 30+ WPM गति प्राप्त हो जाती है।"
  }
];

const breadcrumbItems = [
  { name: "Home", url: "https://typebaazi.com/" },
  { name: "Hindi Typing Test", url: "https://typebaazi.com/hindi-typing-test/" },
  {
    name: "Hindi Practice",
    url: "https://typebaazi.com/hindi-typing-practice/",
  },
];
---

<Layout
  title={pageTitle}
  description={pageDesc}
  keywords={pageKeywords}
  lang="hi"
  activePath="/hindi-typing-practice"
  faqItems={hindiPracticeFaqs}
  breadcrumbs={breadcrumbItems}
>
  <div class="container page-container">
    <!-- Breadcrumbs -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="bc-sep">/</span>
      <a href="/hindi-typing-test/">Hindi Typing Test</a>
      <span class="bc-sep">/</span>
      <span class="bc-current">Hindi Practice</span>
    </nav>

    <!-- Header & Main H1 -->
    <header class="page-header">
      <div class="badge badge-gold">🇮🇳 Devanagari Hindi Typing Masterclass</div>
      <h1 class="page-title">
        Hindi Typing Practice Online (हिंदी टाइपिंग अभ्यास)
      </h1>
      <p class="page-sub">
        Learn touch typing in Hindi with Devanagari Inscript layout. Practice
        vowels (स्वर), consonants (व्यंजन), matras (मात्राएं), and difficult
        words at your own pace.
      </p>
      <div class="header-cta-row">
        <a href="#hindi-practice-arena" class="btn-primary start-typing-btn">
          <span>✍️ Start Hindi Practice Now</span>
        </a>
      </div>
    </header>

    <!-- Interactive Typing Arena -->
    <section
      class="arena-section"
      id="hindi-practice-arena"
      aria-label="हिंदी टाइपिंग प्रॅक्टिस अरेना"
    >
      <TypingArena
        initialLanguage="hindi"
        initialDuration={60}
        initialDifficulty="easy"
        showControls={true}
      />
      <VirtualKeyboard language="hindi" visible={true} />
    </section>

    <!-- Practice Guide & Exercises -->
    <article class="practice-guide-panel glass-panel" itemscope itemtype="https://schema.org/Article">
      <header class="panel-header-block">
        <span class="badge badge-gold">🇮🇳 हिंदी टाइपिंग संपूर्ण पाठ</span>
        <h2 itemprop="headline">हिंदी टाइपिंग अभ्यास पाठ एवं वैज्ञानिक इनस्क्रिप्ट नियमावली</h2>
        <p class="panel-lead-text">
          हिंदी टाइपिंग में गति और 100% सटीकता प्राप्त करने के लिए भारत सरकार द्वारा प्रमाणित <strong>देवनागरी इनस्क्रिप्ट (InScript) कीबोर्ड</strong> सबसे सटीक और वैज्ञानिक माध्यम है। यह पाठमाला आपको होम-रो, मात्राओं, हलंत तथा कठिन संयुक्त अक्षरों का चरणबद्ध अभ्यास कराती है।
        </p>
      </header>

      <!-- Section 1: InScript Home Row & Fingers -->
      <section class="guide-sub-section">
        <h3>१. होम रो (Home Row) कीज़ और उंगलियों का सही विन्यास</h3>
        <p>
          इनस्क्रिप्ट कीबोर्ड पर दोनों हाथों की उंगलियाँ हमेशा होम रो पर टिकी होनी चाहिए। बाएं हाथ की तर्जनी <code>F</code> की पर और दाएं हाथ की तर्जनी <code>J</code> की पर स्थित 'उभरे हुए निशान' (Bump) पर रखें:
        </p>

        <div class="table-responsive">
          <table class="exam-benchmarks-table">
            <thead>
              <tr>
                <th>हाथ (Hand)</th>
                <th>उंगली (Finger)</th>
                <th>की (Physical Key)</th>
                <th>सामान्य वर्ण (Normal)</th>
                <th>शिफ्ट के साथ (Shift Key)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td rowspan="4"><strong>बायां हाथ (स्वर एवं मात्राएँ)</strong></td>
                <td>कनिष्ठिका (Little)</td>
                <td><code>A</code></td>
                <td>ो (ओ की मात्रा)</td>
                <td>ओ</td>
              </tr>
              <tr>
                <td>अनामिका (Ring)</td>
                <td><code>S</code></td>
                <td>े (ए की मात्रा)</td>
                <td>ऐ</td>
              </tr>
              <tr>
                <td>मध्यमा (Middle)</td>
                <td><code>D</code></td>
                <td>् (हलंत)</td>
                <td>अ</td>
              </tr>
              <tr>
                <td>तर्जनी (Index)</td>
                <td><code>F</code> एवं <code>G</code></td>
                <td>ि (इ की मात्रा) / ु (उ की मात्रा)</td>
                <td>इ / उ</td>
              </tr>
              <tr>
                <td rowspan="4"><strong>दायां हाथ (व्यंजन)</strong></td>
                <td>तर्जनी (Index)</td>
                <td><code>H</code> एवं <code>J</code></td>
                <td>प / र</td>
                <td>फ / ऱ</td>
              </tr>
              <tr>
                <td>मध्यमा (Middle)</td>
                <td><code>K</code></td>
                <td>क</td>
                <td>ख</td>
              </tr>
              <tr>
                <td>अनामिका (Ring)</td>
                <td><code>L</code></td>
                <td>त</td>
                <td>थ</td>
              </tr>
              <tr>
                <td>कनिष्ठिका (Little)</td>
                <td><code>;</code></td>
                <td>च</td>
                <td>छ</td>
              </tr>
              <tr>
                <td><strong>दोनों अंगूठे</strong></td>
                <td>अंगूठा (Thumbs)</td>
                <td><code>Spacebar</code></td>
                <td colspan="2" style="text-align: center;">शब्दों के बीच स्पेस (Space)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 2: Matras & Vowel Signs -->
      <section class="guide-sub-section">
        <h3>२. हिंदी मात्राएँ (Matras) लगाने की सही विधि</h3>
        <p>
          देवनागरी इनस्क्रिप्ट में हमेशा पहले मूल व्यंजन टाइप किया जाता है, उसके तुरंत बाद मात्रा की की दबाई जाती है:
        </p>

        <div class="table-responsive">
          <table class="exam-benchmarks-table">
            <thead>
              <tr>
                <th>वर्ण विन्यास</th>
                <th>मात्रा नाम</th>
                <th>कीस्ट्रोक (Keystrokes)</th>
                <th>उदाहरण शब्द</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>क + ा = का</strong></td>
                <td>आ की मात्रा (ा)</td>
                <td><code>k</code> + <code>e</code></td>
                <td>काम, काल, भारत</td>
              </tr>
              <tr>
                <td><strong>क + ि = कि</strong></td>
                <td>ह्रस्व इ की मात्रा (ि)</td>
                <td><code>k</code> + <code>f</code></td>
                <td>किरण, किसान, किताब</td>
              </tr>
              <tr>
                <td><strong>क + ी = की</strong></td>
                <td>दीर्घ ई की मात्रा (ी)</td>
                <td><code>k</code> + <code>r</code></td>
                <td>कीमत, कीचड़, सीख</td>
              </tr>
              <tr>
                <td><strong>क + ु = कु</strong></td>
                <td>ह्रस्व उ की मात्रा (ु)</td>
                <td><code>k</code> + <code>g</code></td>
                <td>कुल, कुशल, सुमन</td>
              </tr>
              <tr>
                <td><strong>क + ू = कू</strong></td>
                <td>दीर्घ ऊ की मात्रा (ू)</td>
                <td><code>k</code> + <code>t</code></td>
                <td>कूदना, कूप, मूल</td>
              </tr>
              <tr>
                <td><strong>क + ृ = कृ</strong></td>
                <td>ऋ की मात्रा (ृ)</td>
                <td><code>k</code> + <code>=</code></td>
                <td>कृपा, कृषि, प्रकृति</td>
              </tr>
              <tr>
                <td><strong>क + े = के</strong></td>
                <td>ए की मात्रा (े)</td>
                <td><code>k</code> + <code>s</code></td>
                <td>केसर, खेल, देश</td>
              </tr>
              <tr>
                <td><strong>क + ै = कै</strong></td>
                <td>ऐ की मात्रा (ै)</td>
                <td><code>k</code> + <code>w</code></td>
                <td>कैमरा, कैसा, सैनिक</td>
              </tr>
              <tr>
                <td><strong>क + ो = को</strong></td>
                <td>ओ की मात्रा (ो)</td>
                <td><code>k</code> + <code>a</code></td>
                <td>कोयल, कोण, मोर</td>
              </tr>
              <tr>
                <td><strong>क + ौ = कौ</strong></td>
                <td>औ की मात्रा (ौ)</td>
                <td><code>k</code> + <code>q</code></td>
                <td>कौन, कौतुक, नौका</td>
              </tr>
              <tr>
                <td><strong>क + ं = कं</strong></td>
                <td>अनुस्वार (ं)</td>
                <td><code>k</code> + <code>x</code></td>
                <td>कंस, रंग, संसार</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 3: Conjunct (संयुक्ताक्षर) Rules -->
      <section class="guide-sub-section">
        <h3>३. संयुक्त अक्षर (Conjuncts) और हलंत (Virama) नियम</h3>
        <p>
          हिंदी में जब दो व्यंजन बिना किसी स्वर के आपस में जुड़ते हैं, तो पहले व्यंजन के बाद <strong>हलंत (् / 'd' की)</strong> दबाया जाता है:
        </p>

        <div class="drills-grid">
          <div class="drill-item">
            <span class="drill-icon">⚡</span>
            <h4>१. क्ष और त्र</h4>
            <p><strong>क + ् + ष = क्ष</strong> (<code>k</code> + <code>d</code> + <code>Shift+,</code>)<br/><strong>त + ् + र = त्र</strong> (<code>l</code> + <code>d</code> + <code>j</code>)</p>
          </div>
          <div class="drill-item">
            <span class="drill-icon">🇮🇳</span>
            <h4>२. ज्ञ और श्र</h4>
            <p><strong>ज + ् + ञ = ज्ञ</strong> (<code>p</code> + <code>d</code> + <code>Shift+&#125;</code>)<br/><strong>श + ् + र = श्र</strong> (<code>Shift+m</code> + <code>d</code> + <code>j</code>)</p>
          </div>
          <div class="drill-item">
            <span class="drill-icon">📝</span>
            <h4>३. प्र और क्र</h4>
            <p><strong>प + ् + र = प्र</strong> (<code>h</code> + <code>d</code> + <code>j</code>)<br/><strong>क + ् + र = क्र</strong> (<code>k</code> + <code>d</code> + <code>j</code>)</p>
          </div>
          <div class="drill-item">
            <span class="drill-icon">🏛️</span>
            <h4>४. द्व और द्ध</h4>
            <p><strong>द + ् + व = द्व</strong> (<code>o</code> + <code>d</code> + <code>b</code>)<br/><strong>द + ् + ध = द्ध</strong> (<code>o</code> + <code>d</code> + <code>Shift+o</code>)</p>
          </div>
        </div>
      </section>

      <!-- Section 4: Nukta Characters -->
      <section class="guide-sub-section">
        <h3>४. नुक्ता (़) वाले अक्षरों का प्रयोग</h3>
        <p>
          उर्दू एवं फ़ारसी मूल के हिंदी शब्दों में नुक्ता आवश्यक होता है। इनस्क्रिप्ट में नुक्ता की <strong>']' (Right Bracket)</strong> पर स्थित होती है:
        </p>
        <ul class="feature-bullets-list">
          <li><strong>ज़ (Za):</strong> <code>p</code> (ज) + <code>]</code> (़) &rarr; ज़िंदगी, ज़िला, आवाज़</li>
          <li><strong>फ़ (Fa):</strong> <code>Shift + h</code> (फ) + <code>]</code> (़) &rarr; फ़ैसला, फ़िल्म, फ़ायदा</li>
          <li><strong>ड़ (Dda):</strong> <code>[</code> (ड) + <code>]</code> (़) &rarr; सड़क, पेड़, कपड़ा</li>
          <li><strong>ढ़ (Ddha):</strong> <code>Shift + [</code> (ढ) + <code>]</code> (़) &rarr; पढ़ना, चढ़ना, सीढ़ी</li>
        </ul>
      </section>

      <!-- Related Links -->
      <div class="related-links-box">
        <h3>More Typing Hubs on TypeBaazi</h3>
        <div class="links-grid">
          <a href="/hindi-typing-test/" class="hub-link-card">
            <span class="hub-icon">⏱️</span>
            <div>
              <strong>Hindi Typing Test</strong>
              <span>Timed 1-min &amp; 7-min speed tests with PDF certificates.</span>
            </div>
          </a>
          <a href="/seven-minute-typing-test/" class="hub-link-card">
            <span class="hub-icon">📋</span>
            <div>
              <strong>7-Minute Exam Simulator</strong>
              <span>30 WPM &amp; 40 WPM mock test with 50+ passages.</span>
            </div>
          </a>
          <a href="/guides/hindi-typing-exam-preparation/" class="hub-link-card">
            <span class="hub-icon">📚</span>
            <div>
              <strong>Hindi Exam Preparation Guide</strong>
              <span>Complete preparation handbook for SSC &amp; CPCT tests.</span>
            </div>
          </a>
          <a href="/marathi-typing-practice/" class="hub-link-card">
            <span class="hub-icon">🇮🇳</span>
            <div>
              <strong>Marathi Typing Practice</strong>
              <span>Devanagari Marathi letters &amp; paragraph drills.</span>
            </div>
          </a>
          <a href="/race/" class="hub-link-card">
            <span class="hub-icon">🏎️</span>
            <div>
              <strong>Typing Race Game</strong>
              <span>Compete against AI cars with nitro boosts in Hindi!</span>
            </div>
          </a>
          <a href="/government-exam-typing-practice/" class="hub-link-card">
            <span class="hub-icon">🏛️</span>
            <div>
              <strong>Government Exam Typing Practice</strong>
              <span>Practice central and state clerical exam formats.</span>
            </div>
          </a>
        </div>
      </div>

      <!-- FAQ Accordion -->
      <div class="seo-faq-block" style="margin-top: 24px;">
        <h3>अक्सर पूछे जाने वाले प्रश्न (FAQ)</h3>
        <div class="faq-accordion">
          {hindiPracticeFaqs.map((item) => (
            <details class="faq-item">
              <summary class="faq-question">
                <span>{item.question}</span>
                <span class="faq-arrow">&darr;</span>
              </summary>
              <div class="faq-answer">
                <p>{item.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </article>
  </div>
</Layout>

<style is:global>
  .page-container {
    padding: clamp(16px, 2.5vw, 24px) clamp(12px, 2vw, 20px) 50px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .breadcrumb-nav {
    display: flex;
